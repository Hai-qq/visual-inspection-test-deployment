                                                <ComboBoxItem Content="数量范围" />
                                                <ComboBoxItem Content="数量大于" />
                                                <ComboBoxItem Content="数量不等于" />
                                                <ComboBoxItem Content="数量大于等于" />
                                                <ComboBoxItem Content="数量小于" />
