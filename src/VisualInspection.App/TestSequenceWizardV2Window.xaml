                                               Text="动作设置"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,0,16,0"
                                               ToolTip="按从左到右的顺序配置；保存后返回基本信息。" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CancelPoseActionEditorButton" Content="取消"
                                                Click="CancelPoseActionEditor_Click" Margin="0,0,10,0" />
                                        <Button x:Name="ApplyPoseActionEditorButton" Content="保存并返回基本信息"
                                                Click="ApplyPoseActionEditor_Click" Style="{StaticResource WizardPrimaryButton}"
                                                Padding="16,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

        <Grid x:Name="DetectionEditorOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Collapsed"
              Background="#8F26322D">
            <Border MaxWidth="860" MaxHeight="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="White" BorderBrush="#819089" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="选择检测标签" FontSize="18" FontWeight="SemiBold"
                                           ToolTip="选择一个检测标签后进入独立的区域与判定配置；保存后可继续选择下一个。" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" Click="CloseDetectionEditor_Click"
                                    ToolTip="完成并关闭检测标签选择" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Padding="22,18">
                        <StackPanel>
                            <Border Style="{StaticResource PanelBorder}" Padding="16" Background="#FBFCFB">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检测模型" FontWeight="SemiBold" />
                                        <TextBlock Text="来自当前测试步的基本信息" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="36" Padding="11,0"
                                            Background="#F4F7F5" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="{Binding SelectedInspectionItem.Model.Name}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenDarkBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,10">
                                <StackPanel>
                                    <TextBlock Text="逐个配置检测标签" FontSize="15" FontWeight="SemiBold"
                                               ToolTip="点选一项会打开独立配置；每次保存只新增或更新这一项。" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GreenPaleBrush}"
                                        BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                    <TextBlock Text="{Binding DetectionEditor.SelectedLabelSummary}" FontSize="12"
                                               Foreground="{StaticResource GreenDarkBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DetectionEditor.LabelOptions}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button CommandParameter="{Binding}" Click="OpenDetectionLabelEditor_Click"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                    Padding="14,8" Background="#FBFCFB">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="105" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsConfigured, Mode=OneWay}" IsHitTestVisible="False"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                                        <StackPanel Margin="0,5,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ScopeSummary}" FontSize="12"
                                                                       Foreground="{StaticResource GreenDarkBrush}" />
                                                            <TextBlock Text="{Binding RuleSummary}" FontSize="12"
                                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ConfigurationStatus}" FontSize="12" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ConfigurationAction}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource GreenDarkBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid>
                            <TextBlock x:Name="DetectionEditorStatusText"
                                       Text="检测标签配置" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                       ToolTip="选择一个检测标签进入独立配置；每次保存只更新当前标签。" />
                            <Button Content="完成" Click="CloseDetectionEditor_Click" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Style="{StaticResource WizardPrimaryButton}" Padding="22,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DetectionLabelEditorOverlay" Grid.RowSpan="4" Panel.ZIndex="110" Visibility="Collapsed"
              Background="#9626322D">
            <Border x:Name="DetectionLabelEditorCard" MaxWidth="1140" MaxHeight="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                     Background="White" BorderBrush="#819089" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                           ToolTip="区域和判定条件只属于当前检测标签；保存后回到列表继续配置其他标签。">
                                    <Run Text="配置检测标签 · " />
                                    <Run Text="{Binding DetectionEditor.ActiveLabel.Label, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" Click="CancelDetectionLabelEditor_Click"
                                    ToolTip="取消当前检测标签的未保存修改" />
                        </Grid>
                    </Border>

                     <Grid Grid.Row="1" Margin="16,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                         <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DetectionLabelRegionColumn" Width="3*" />
                            <ColumnDefinition x:Name="DetectionLabelGapColumn" Width="18" />
                            <ColumnDefinition x:Name="DetectionLabelRuleColumn" Width="2*" />
                        </Grid.ColumnDefinitions>
<Border Style="{StaticResource PanelBorder}" Grid.ColumnSpan="3" Padding="12" Margin="0,0,0,12" Background="#FBFCFB">
                                    <StackPanel>
                                        <TextBlock Text="检测区域" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                                   ToolTip="默认检测整张图；选择 ROI 后须先导入标注底图。" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="FullImageRegionRadioButton" Content="是，检测整张图（默认）"
                                                         GroupName="DetectionLabelScope"
                                                         IsChecked="{Binding DetectionEditor.ActiveLabel.UseFullImage, Mode=TwoWay}"
                                                         Checked="DetectionArea_Changed" Margin="0,0,28,0" />
                                            <RadioButton x:Name="RoiRegionRadioButton" Content="否，选择 ROI"
                                                         GroupName="DetectionLabelScope"
                                                         IsChecked="{Binding DetectionEditor.ActiveLabel.UseRoi, Mode=TwoWay}"
                                                         Checked="DetectionArea_Changed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>


                        <Grid x:Name="DetectionLabelRegionViewer" Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource PanelBorder}" Padding="12,10">
                                <StackPanel Orientation="Horizontal" ToolTip="需要使用 ROI 时，先导入标注底图并勾选区域。">
                                    <TextBlock Text="使用的 ROI" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <ItemsControl ItemsSource="{Binding DetectionEditor.ActiveLabel.RoiOptions}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="DetectionRoiSelection_Changed" Unchecked="DetectionRoiSelection_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="默认 ROI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="导入标注底图" Click="ImportRoiBackground_Click" ToolTip="{Binding SelectedInspectionItem.RoiBackgroundPath}"/>
                                    </Grid>
                                    <ListBox x:Name="NamedRoisListBox" Visibility="Collapsed" ItemsSource="{Binding SelectedInspectionItem.NamedRois}"
                                                     BorderThickness="0" Background="Transparent" Margin="0,10,0,8"
                                                     SelectionChanged="NamedRoisListBox_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                                                Padding="9" Margin="0,0,0,5" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="105" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding CoordinateSummary}" FontSize="12"
                                                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                    <Grid x:Name="RoiPreviewSurface" Grid.Row="1" MinHeight="160" Margin="0,10,0,8" Background="#EEF2F0" Cursor="Cross"
                                                  Focusable="True" ClipToBounds="True"
                                                  Loaded="RoiPreviewSurface_Loaded" SizeChanged="RoiPreviewSurface_SizeChanged"
                                                  MouseLeftButtonDown="RoiPreviewSurface_MouseLeftButtonDown"
                                                  MouseMove="RoiPreviewSurface_MouseMove"
                                                  MouseLeftButtonUp="RoiPreviewSurface_MouseLeftButtonUp"
                                                  LostMouseCapture="RoiPreviewSurface_LostMouseCapture">
                                                <Image x:Name="RoiBackgroundImage" Source="{Binding SelectedInspectionItem.RoiBackgroundImage}"
                                                       Stretch="Uniform" IsHitTestVisible="False" />
                                                <TextBlock Text="请先导入标注底图" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedInspectionItem.RoiBackgroundImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Canvas x:Name="RoiOverlayCanvas" Background="Transparent" ClipToBounds="True">
                                                    <Rectangle x:Name="RoiSelectionRectangle" Stroke="{StaticResource GreenDarkBrush}" StrokeThickness="3"
                                                               StrokeDashArray="6 3" Fill="#18FFFFFF" IsHitTestVisible="False" />
                                                    <Border x:Name="RoiSelectionLabel" Background="{StaticResource GreenDarkBrush}" Padding="8,4"
                                                            CornerRadius="2" IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding SelectedNamedRoi.Name}" Foreground="White" FontSize="12" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RoiCoordinatesText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Button x:Name="RedrawRoiButton" Grid.Column="1" Content="重新框选" Click="RedrawRoiButton_Click" Padding="10,6" ToolTip="在导入的底图上拖动，更新默认 ROI。"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="DetectionLabelRulePanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16" Background="#FBFCFB">
                            <ScrollViewer x:Name="DetectionLabelRuleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="判定条件" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DetectionLabelScopeSummaryText" Text="{Binding DetectionEditor.ActiveLabel.ScopeSummary}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="统计内容" FontSize="13"/><TextBlock x:Name="DetectionMetricRequiredStar" Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.MetricIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="识别数量"/><ComboBoxItem Content="缺失数量"/><ComboBoxItem Content="是否存在"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="判断方式" FontSize="13"/><TextBlock x:Name="DetectionMethodRequiredStar" Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.RuleMethodIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="等于（=）"/><ComboBoxItem Content="范围（含边界）"/><ComboBoxItem Content="大于（&gt;）"/><ComboBoxItem Content="不等于（!=）"/><ComboBoxItem Content="大于等于（&gt;=）"/><ComboBoxItem Content="小于（&lt;）"/><ComboBoxItem Content="小于等于（&lt;=）"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="数量 / 下限" FontSize="13"/><TextBlock x:Name="DetectionThresholdRequiredStar" Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <TextBox Height="36" Padding="10,6" Text="{Binding DetectionEditor.ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="条件满足时" FontSize="13"/><TextBlock x:Name="DetectionOutcomeRequiredStar" Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.OutcomeIndex, Mode=TwoWay}"><ComboBoxItem Content="Pass"/><ComboBoxItem Content="Fail"/></ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DetectionEditor.MetricIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="应有总数" FontSize="13"/><TextBlock Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <TextBox Height="36" Padding="10,6" Text="{Binding DetectionEditor.ExpectedTotalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="缺失数量 = max(应有总数 − 识别数量, 0)" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DetectionEditor.RuleMethodIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="上限" FontSize="13"/><TextBlock x:Name="DetectionUpperThresholdRequiredStar" Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <TextBox Height="36" Padding="10,6" Text="{Binding DetectionEditor.UpperThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                            <TextBlock x:Name="DetectionConfidenceLabelText" Text="置信度阈值（可选，默认 0.5）" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap" ToolTip="留空时按 0.5 保存；填写时取值必须在 0 到 1 之间。"/>
                                            <TextBox x:Name="DetectionConfidenceTextBox" Height="36" Width="160" MaxWidth="220" HorizontalAlignment="Left" Padding="10,6" Text="{Binding DetectionEditor.ConfidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                                        <StackPanel><TextBlock Text="判定预览" FontSize="12" Foreground="{StaticResource GreenDarkBrush}"/><TextBlock Text="{Binding DetectionEditor.RuleSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetectionLabelEditorStatusText" MaxHeight="40" TextTrimming="CharacterEllipsis" Text="请完成当前检测标签的区域与判定设置。" TextWrapping="Wrap" Margin="0,0,16,0"
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="取消" Click="CancelDetectionLabelEditor_Click" Margin="0,0,10,0" />
                                <Button x:Name="ApplyDetectionLabelEditorButton" Content="保存当前检测标签"
                                        Click="ApplyDetectionLabelEditor_Click" Style="{StaticResource WizardPrimaryButton}" Padding="18,6" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
