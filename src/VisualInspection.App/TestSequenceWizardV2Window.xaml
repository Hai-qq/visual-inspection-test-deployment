                                            <Rectangle x:Name="LegacyRoiSelectionRectangle" Stroke="{StaticResource GreenDarkBrush}" StrokeThickness="3"
                                                       StrokeDashArray="6 3" Fill="#18FFFFFF" IsHitTestVisible="False" />
