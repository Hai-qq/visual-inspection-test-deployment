                                                    CornerRadius="2" IsHitTestVisible="False">
                                                <TextBlock Text="fan 检测区域" Foreground="White" FontSize="9" />
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="2" Margin="24,0" VerticalScrollBarVisibility="Auto">
