                                    <Border Style="{StaticResource SummaryRow}"><StackPanel><TextBlock Text="序列号与启动" FontWeight="SemiBold" /><TextBlock Text="文件夹图源以每张图片的文件名作为序列号；只有摄像头图源在开始时弹窗输入，并执行一次检测。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource SummaryRow}"><StackPanel><TextBlock Text="运行结果显示" FontWeight="SemiBold" /><TextBlock Text="检测图保留原始图片、检测框和模型原始英文 Label，不显示置信度；当前检测项按检测标签、判定逻辑、本次实测和红绿 Result 表格显示。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                                    <Border Style="{StaticResource SummaryRow}"><StackPanel><TextBlock Text="生产记录" FontWeight="SemiBold" /><TextBlock Text="运行时同时保留内部 JSONL 审计，并写生产 TXT；结果图片按 pass / fail 分类保存。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="CompletionStatusBorder" Grid.Row="3" Visibility="Collapsed"
                                    Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1"
                                    CornerRadius="4" Padding="16" Margin="0,14,0,0">
                                <TextBlock x:Name="CompletionStatusText" Text="设置已完成。"
                                           Foreground="{StaticResource GreenDarkBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="FooterHintText" Text="第 1 / 5 步"
                           FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                           ToolTip="红色 * 为必填项；操作说明请悬停信息图标、标题或控件查看。" />
                <StackPanel x:Name="WizardNavigationPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton" Content="上一步" Click="PreviousButton_Click" Margin="0,0,10,0" />
                    <Button x:Name="ExportSequenceButton" Content="导出 Sequence 与模型" Click="ExportSequenceButton_Click"
                            Visibility="Collapsed" MinWidth="154" Margin="0,0,10,0"
                            ToolTip="选择保存位置，导出可移植的 Sequence 逻辑文件和对应模型；导出不会切换当前操作台。" />
                    <Button x:Name="NextButton" Content="下一步：选择图源" Click="NextButton_Click" Style="{StaticResource WizardPrimaryButton}" MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DetectionEditorOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Collapsed"
              Background="#8F26322D">
            <Border Width="860" MaxHeight="760" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#819089" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="选择检测标签" FontSize="18" FontWeight="SemiBold"
                                           ToolTip="选择一个检测标签后进入独立的区域与判定配置；保存后可继续选择下一个。" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Width="32" Height="32" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" Click="CloseDetectionEditor_Click"
                                    ToolTip="完成并关闭检测标签选择" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Padding="22,18">
                        <StackPanel>
                            <Border Style="{StaticResource PanelBorder}" Padding="16" Background="#FBFCFB">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检测模型" FontWeight="SemiBold" />
                                        <TextBlock Text="来自当前测试步的基本信息" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="36" Padding="11,0"
                                            Background="#F4F7F5" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="3">
                                        <TextBlock Text="{Binding SelectedInspectionItem.Model.Name}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenDarkBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,10">
                                <StackPanel>
                                    <TextBlock Text="逐个配置检测标签" FontSize="15" FontWeight="SemiBold"
                                               ToolTip="点选一项会打开独立配置；每次保存只新增或更新这一项。" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GreenPaleBrush}"
                                        BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                    <TextBlock Text="{Binding DetectionEditor.SelectedLabelSummary}" FontSize="9"
                                               Foreground="{StaticResource GreenDarkBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DetectionEditor.LabelOptions}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button CommandParameter="{Binding}" Click="OpenDetectionLabelEditor_Click"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Width="780" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                            <Border Width="780" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                    Padding="14,12" Background="#FBFCFB">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="105" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsConfigured, Mode=OneWay}" IsHitTestVisible="False"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,14,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                                        <StackPanel Margin="0,5,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ScopeSummary}" FontSize="9"
                                                                       Foreground="{StaticResource GreenDarkBrush}" />
                                                            <TextBlock Text="{Binding RuleSummary}" FontSize="9"
                                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ConfigurationStatus}" FontSize="9" HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ConfigurationAction}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource GreenDarkBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid>
                            <TextBlock x:Name="DetectionEditorStatusText"
                                       Text="检测标签配置" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                       ToolTip="选择一个检测标签进入独立配置；每次保存只更新当前标签。" />
                            <Button Content="完成" Click="CloseDetectionEditor_Click" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Style="{StaticResource WizardPrimaryButton}" Padding="22,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DetectionLabelEditorOverlay" Grid.RowSpan="4" Panel.ZIndex="110" Visibility="Collapsed"
              Background="#9626322D">
            <Border Width="1140" MaxHeight="760" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Background="White" BorderBrush="#819089" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="66" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold"
                                           ToolTip="区域和判定条件只属于当前检测标签；保存后回到列表继续配置其他标签。">
                                    <Run Text="配置检测标签 · " />
                                    <Run Text="{Binding DetectionEditor.ActiveLabel.Label, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Width="32" Height="32" Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets" Click="CancelDetectionLabelEditor_Click"
                                    ToolTip="取消当前检测标签的未保存修改" />
                        </Grid>
                    </Border>

                     <Grid Grid.Row="1" Margin="22,18">
                         <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DetectionLabelRegionColumn" Width="3*" />
                            <ColumnDefinition x:Name="DetectionLabelGapColumn" Width="18" />
                            <ColumnDefinition x:Name="DetectionLabelRuleColumn" Width="2*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <StackPanel>
                                <Border Style="{StaticResource PanelBorder}" Padding="16" Background="#FBFCFB">
                                    <StackPanel>
                                        <TextBlock Text="1 · 当前检测标签是否检测整张图？" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                                                   ToolTip="默认检测整张图；选择 ROI 后须先导入标注底图。" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="FullImageRegionRadioButton" Content="是，检测整张图（默认）"
                                                         GroupName="DetectionLabelScope"
                                                         IsChecked="{Binding DetectionEditor.ActiveLabel.UseFullImage, Mode=TwoWay}"
                                                         Checked="DetectionArea_Changed" Margin="0,0,28,0" />
                                            <RadioButton x:Name="RoiRegionRadioButton" Content="否，选择 ROI"
                                                         GroupName="DetectionLabelScope"
                                                         IsChecked="{Binding DetectionEditor.ActiveLabel.UseRoi, Mode=TwoWay}"
                                                         Checked="DetectionArea_Changed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetectionEditor.ActiveLabel.UseRoi}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border Style="{StaticResource PanelBorder}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="2 · 为当前检测标签选择区域" FontSize="14" FontWeight="SemiBold"
                                                       ToolTip="每个检测标签可选择同一个默认 ROI；需要使用 ROI 时须先导入标注底图。" />
                                            <ItemsControl ItemsSource="{Binding DetectionEditor.ActiveLabel.RoiOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Checked="DetectionRoiSelection_Changed"
                                                                  Unchecked="DetectionRoiSelection_Changed"
                                                                  Margin="0,0,18,8" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="ⓘ" FontSize="12" Foreground="#76550D"
                                                       ToolTip="ROI 仅适用于机位固定、画面位置稳定的场景。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid ToolTip="先导入一张图作为 ROI 标注底图，然后在下方拖动框选默认 ROI。">
                                                <StackPanel>
                                                    <TextBlock Text="默认 ROI" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedInspectionItem.RoiBackgroundPath}" MaxWidth="350"
                                                               TextTrimming="CharacterEllipsis" FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Content="导入标注底图" Click="ImportRoiBackground_Click"
                                                        MinWidth="116" Padding="12,5" VerticalAlignment="Center" />
                                            </Grid>
                                            <ListBox x:Name="NamedRoisListBox" ItemsSource="{Binding SelectedInspectionItem.NamedRois}"
                                                     BorderThickness="0" Background="Transparent" Margin="0,10,0,8"
                                                     SelectionChanged="NamedRoisListBox_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                                                Padding="9" Margin="0,0,0,5" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="105" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding CoordinateSummary}" FontSize="9"
                                                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid x:Name="RoiPreviewSurface" Height="190" Background="#EEF2F0" Cursor="Cross"
                                                  Focusable="True" ClipToBounds="True"
                                                  Loaded="RoiPreviewSurface_Loaded" SizeChanged="RoiPreviewSurface_SizeChanged"
                                                  MouseLeftButtonDown="RoiPreviewSurface_MouseLeftButtonDown"
                                                  MouseMove="RoiPreviewSurface_MouseMove"
                                                  MouseLeftButtonUp="RoiPreviewSurface_MouseLeftButtonUp"
                                                  LostMouseCapture="RoiPreviewSurface_LostMouseCapture">
                                                <Image x:Name="RoiBackgroundImage" Source="{Binding SelectedInspectionItem.RoiBackgroundImage}"
                                                       Stretch="Uniform" IsHitTestVisible="False" />
                                                <TextBlock Text="请先导入标注底图" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedInspectionItem.RoiBackgroundImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Canvas x:Name="RoiOverlayCanvas" Background="Transparent" ClipToBounds="True">
                                                    <Rectangle x:Name="RoiSelectionRectangle" Stroke="{StaticResource GreenDarkBrush}" StrokeThickness="3"
                                                               StrokeDashArray="6 3" Fill="#18FFFFFF" IsHitTestVisible="False" />
                                                    <Border x:Name="RoiSelectionLabel" Background="{StaticResource GreenDarkBrush}" Padding="8,4"
                                                            CornerRadius="2" IsHitTestVisible="False">
                                                        <TextBlock Text="{Binding SelectedNamedRoi.Name}" Foreground="White" FontSize="9" />
                                                    </Border>
                                                </Canvas>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <TextBlock x:Name="RoiCoordinatesText" Text="X1 120  ·  Y1 80  ·  X2 520  ·  Y2 420"
                                                           FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                <Button x:Name="RedrawRoiButton" Content="重新框选" Click="RedrawRoiButton_Click"
                                                        HorizontalAlignment="Right" Padding="9,3"
                                                        ToolTip="在导入的底图上拖动，更新默认 ROI。" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="DetectionLabelRulePanel" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18" Background="#FBFCFB">
                            <StackPanel>
                                     <TextBlock Text="当前检测标签的判定条件" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"
                                                ToolTip="这里填写的值只保存给当前检测标签。" />

                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="3" Padding="11" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="检测区域" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock x:Name="DetectionLabelScopeSummaryText"
                                                       Text="{Binding DetectionEditor.ActiveLabel.ScopeSummary}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="统计内容" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="DetectionMetricRequiredStar" Style="{StaticResource RequiredStar}" />
                                    </StackPanel>
                                    <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.MetricIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="识别数量" />
                                        <ComboBoxItem Content="缺失数量" />
                                        <ComboBoxItem Content="是否存在" />
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="判断方式" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="DetectionMethodRequiredStar" Style="{StaticResource RequiredStar}" />
                                    </StackPanel>
                                    <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.RuleMethodIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="等于（=）" />
                                        <ComboBoxItem Content="范围（含边界）" />
                                        <ComboBoxItem Content="大于（&gt;）" />
                                        <ComboBoxItem Content="不等于（!=）" />
                                        <ComboBoxItem Content="大于等于（&gt;=）" />
                                        <ComboBoxItem Content="小于（&lt;）" />
                                        <ComboBoxItem Content="小于等于（&lt;=）" />
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="数量 / 下限" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="DetectionThresholdRequiredStar" Style="{StaticResource RequiredStar}" />
                                    </StackPanel>
                                    <TextBox Height="36" Padding="10,6"
                                             Text="{Binding DetectionEditor.ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Margin="0,14,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionEditor.RuleMethodIndex}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="上限" Style="{StaticResource FieldLabel}" />
                                            <TextBlock x:Name="DetectionUpperThresholdRequiredStar" Style="{StaticResource RequiredStar}" />
                                        </StackPanel>
                                        <TextBox Height="36" Padding="10,6"
                                                 Text="{Binding DetectionEditor.UpperThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="条件满足时" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="DetectionOutcomeRequiredStar" Style="{StaticResource RequiredStar}" />
                                    </StackPanel>
                                    <ComboBox Height="36" SelectedIndex="{Binding DetectionEditor.OutcomeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Pass" />
                                        <ComboBoxItem Content="Fail" />
                                    </ComboBox>

                                    <TextBlock x:Name="DetectionConfidenceLabelText" Text="置信度阈值（可选，默认 0.5）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"
                                               ToolTip="留空时按 0.5 保存；填写时取值必须在 0 到 1 之间。" />
                                    <TextBox Height="36" Padding="10,6"
                                             Text="{Binding DetectionEditor.ConfidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1"
                                            CornerRadius="4" Padding="14" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="当前检测标签判定预览" FontSize="9" Foreground="{StaticResource GreenDarkBrush}" />
                                            <TextBlock Text="{Binding DetectionEditor.RuleSummary}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GreenDarkBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                            </StackPanel>
                         </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid>
                            <TextBlock x:Name="DetectionLabelEditorStatusText" Text="请完成当前检测标签的区域与判定设置。"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="取消" Click="CancelDetectionLabelEditor_Click" Margin="0,0,10,0" />
                                <Button x:Name="ApplyDetectionLabelEditorButton" Content="保存当前检测标签"
                                        Click="ApplyDetectionLabelEditor_Click" Style="{StaticResource WizardPrimaryButton}" Padding="18,6" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
