                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="规则组合" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <ComboBox x:Name="RuleLogicalOperatorComboBox" Height="36"
                                                      SelectedIndex="{Binding SelectedInspectionItem.RuleLogicalOperatorIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="AND · 全部满足" />
                                                <ComboBoxItem Content="OR · 任一满足" />
                                            </ComboBox>
                                            <TextBlock Text="统计语义" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,6" />
                                            <ComboBox x:Name="PrimaryRuleMetricComboBox" Height="36"
                                                      SelectedIndex="{Binding SelectedInspectionItem.RuleMetricIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Present Count" />
                                                <ComboBoxItem Content="Missing Count" />
                                                <ComboBoxItem Content="Presence" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Confidence" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <TextBox x:Name="PrimaryRuleConfidenceTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.ConfidenceThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="条件满足时" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <ComboBox x:Name="PrimaryRuleOutcomeComboBox" Height="36"
                                                      SelectedIndex="{Binding SelectedInspectionItem.RuleOutcomeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Pass" />
                                                <ComboBoxItem Content="Fail" />
                                            </ComboBox>
                                        </StackPanel>
                                        <Button x:Name="AddAdditionalRuleButton" Grid.Column="5" Content="+ 规则" Margin="12,20,0,0"
                                                Click="AddAdditionalRule_Click" Padding="10,5" VerticalAlignment="Top" />
                                    </Grid>
                                    <ItemsControl x:Name="AdditionalRulesItemsControl"
                                                  ItemsSource="{Binding SelectedInspectionItem.AdditionalRules}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                                        Padding="9" Margin="0,0,0,7" Background="#FBFCFB">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="34" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Height="30" Margin="3,0" ToolTip="规则使用的 Model Artifact"
                                                                  ItemsSource="{Binding DataContext.Models, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Model, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" />
                                                        <ComboBox Grid.Column="1" Height="30" Margin="3,0" ToolTip="稳定标签 ID 对应的模型标签"
                                                                  ItemsSource="{Binding Model.Labels}"
                                                                  SelectedItem="{Binding TargetLabel, Mode=TwoWay}" />
                                                        <ComboBox Grid.Column="2" Height="30" Margin="3,0" SelectedIndex="{Binding MetricIndex, Mode=TwoWay}">
                                                            <ComboBoxItem Content="Present" />
                                                            <ComboBoxItem Content="Missing" />
                                                            <ComboBoxItem Content="Presence" />
                                                        </ComboBox>
                                                        <ComboBox Grid.Column="3" Height="30" Margin="3,0" SelectedIndex="{Binding RuleMethodIndex, Mode=TwoWay}">
                                                            <ComboBoxItem Content="数量等于" />
                                                            <ComboBoxItem Content="数量范围" />
                                                            <ComboBoxItem Content="数量大于" />
                                                            <ComboBoxItem Content="数量不等于" />
                                                            <ComboBoxItem Content="数量大于等于" />
                                                            <ComboBoxItem Content="数量小于" />
                                                            <ComboBoxItem Content="数量小于等于" />
                                                        </ComboBox>
                                                        <TextBox Grid.Column="4" Height="30" Margin="3,0" Padding="7,4" ToolTip="Threshold"
                                                                 Text="{Binding ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="5" Height="30" Margin="3,0" Padding="7,4" ToolTip="Upper Threshold（仅 BetweenInclusive 使用）"
                                                                 Text="{Binding UpperThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="6" Height="30" Margin="3,0" Padding="7,4" ToolTip="Confidence"
                                                                 Text="{Binding ConfidenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Column="7" Height="30" Margin="3,0" SelectedIndex="{Binding OutcomeIndex, Mode=TwoWay}">
                                                            <ComboBoxItem Content="Pass" />
                                                            <ComboBoxItem Content="Fail" />
                                                        </ComboBox>
                                                        <Button Grid.Column="8" Content="&#xE738;" Style="{StaticResource IconButton}"
                                                                CommandParameter="{Binding}" Click="RemoveAdditionalRule_Click" Foreground="#A33A32" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="22" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="最终判定" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                        <TextBlock x:Name="TargetRuleSummaryText"
                                                   Text="正在根据当前目标设置生成最终判定……"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PoseRulePanel" Visibility="Collapsed">
                                <Border Style="{StaticResource PanelBorder}" Padding="22">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="当前动作" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="为动作序列中的每一步分别设置识别条件和时间限制。" />
                                            </StackPanel>
                                            <ComboBox x:Name="PoseActionComboBox" Height="36"
                                                      ItemsSource="{Binding PoseSteps}" DisplayMemberPath="DisplayLabel"
                                                      SelectedIndex="{Binding SelectedInspectionItem.PoseActionIndex, Mode=TwoWay}"
                                                      SelectionChanged="RequiredSelection_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="最短保持（ms）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="动作需要连续满足这么久才算完成，用于过滤偶发误识别。" />
                                            </StackPanel>
                                            <TextBox x:Name="PoseHoldTimeTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.SelectedPoseAction.MinimumHoldMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="RequiredField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="最大等待（ms）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="超过该时间仍未完成当前动作时，这个姿态测试步判定失败。" />
                                            </StackPanel>
                                            <TextBox x:Name="PoseMaxWaitTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.SelectedPoseAction.MaximumWaitMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="RequiredField_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="动作 Model" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <ComboBox Height="36" ItemsSource="{Binding Models}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedInspectionItem.SelectedPoseAction.Model, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="动作条件 / 检测标签" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <TextBox Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.SelectedPoseAction.ActionCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Confidence" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                            <TextBox x:Name="PoseConfidenceTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.SelectedPoseAction.ConfidenceThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="22" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="最终判定" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                        <TextBlock x:Name="PoseRuleSummaryText"
                                                   Text="正在根据当前姿态设置生成最终判定……"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step8Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,48,0,0">
                        <StackPanel Margin="24,10" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <StackPanel>
                                 <TextBlock Text="设置当前测试步的自定义函数" Visibility="Collapsed" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"
                                            ToolTip="每个测试步独立保存函数入口、名称、路径和延时参数。" />
                                 <Border Visibility="Collapsed" Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1"
                                         CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="自定义函数摘要" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                        <TextBlock x:Name="CustomFunctionSummaryText"
                                                   Text="{Binding SelectedInspectionItem.FunctionContractSummary}"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Padding="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="函数入口" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" ToolTip="函数类型、名称、路径和说明会随配置保存；当前不调用函数，只有测试步延时生效。" />
                                            <TextBlock Grid.Column="1" Text="当前测试步" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <ComboBox x:Name="CustomFunctionStepComboBox" Grid.Column="2" Height="36"
                                                      ItemsSource="{Binding InspectionItems}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedInspectionItem, Mode=OneWay}"
                                                      SelectionChanged="CustomFunctionStepComboBox_SelectionChanged" />
                                        </Grid>
                                        <TextBlock Text="仅保存函数配置，当前不执行函数；下方延时仍用于测试步等待。"
                                                   Foreground="#76550D" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="函数类型" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CustomFunctionTypeComboBox" Height="36"
                                                          SelectedIndex="{Binding SelectedInspectionItem.CustomFunctionTypeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Python 文件" />
                                                    <ComboBoxItem Content="内置函数（后续提供）" />
                                                    <ComboBoxItem Content="预留函数（后续提供）" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="函数名称" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                </StackPanel>
                                                <TextBox x:Name="CustomFunctionNameTextBox" Height="36" Padding="10,6"
                                                         Text="{Binding SelectedInspectionItem.CustomFunctionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="RequiredField_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="延时（ms）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                </StackPanel>
                                                <TextBox x:Name="CustomFunctionDelayTextBox" Height="36" Padding="10,6"
                                                         Text="{Binding SelectedInspectionItem.CustomFunctionDelayMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="RequiredField_TextChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="函数文件 / 路径" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="CustomFunctionFileTextBox" Height="36" Padding="10,6"
                                                         Text="{Binding SelectedInspectionItem.CustomFunctionFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="RequiredField_TextChanged" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="选择文件" Click="SelectCustomFunctionFile_Click"
                                                    Margin="12,20,0,0" VerticalAlignment="Top" />
                                        </Grid>
                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="说明" Style="{StaticResource FieldLabel}" />
                                            <TextBox Height="60" Padding="10,7" AcceptsReturn="True" TextWrapping="Wrap"
                                                     Text="{Binding SelectedInspectionItem.CustomFunctionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="Collapsed">
                            <TextBlock Text="定义当前测试步的触发与运行接口" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="把检测功能封装成可调用模块：可由测试序列调用，也可等待 PLC、IO 或传感器信号。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18" />

                            <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="函数接口摘要" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                    <TextBlock x:Name="FunctionContractSummaryText"
                                               Text="{Binding SelectedInspectionItem.FunctionContractSummary}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorder}" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="入口触发" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="允许的调用入口（可多选）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="序列调用表示由 Test Sequence 发起，但不规定当前测试步列表中的排列顺序；外部信号用于接 PLC、IO 或传感器；手动调用用于调试。" />
                                            </StackPanel>
                                            <StackPanel>
                                                <CheckBox x:Name="AllowSequenceInvocationCheckBox" Content="Test Sequence 调用"
                                                          IsChecked="{Binding SelectedInspectionItem.AllowSequenceInvocation, Mode=TwoWay}"
                                                          Checked="TriggerEntry_Changed" Unchecked="TriggerEntry_Changed" Margin="0,0,0,5" />
                                                <CheckBox x:Name="ExternalTriggerEnabledCheckBox" Content="外部信号（PLC / IO / 传感器）"
                                                          IsChecked="{Binding SelectedInspectionItem.ExternalTriggerEnabled, Mode=TwoWay}"
                                                          Checked="TriggerEntry_Changed" Unchecked="TriggerEntry_Changed" Margin="0,0,0,5" />
                                                <CheckBox x:Name="AllowManualDebugInvocationCheckBox" Content="操作员 / 调试工具手动调用"
                                                          IsChecked="{Binding SelectedInspectionItem.AllowManualDebugInvocation, Mode=TwoWay}"
                                                          Checked="TriggerEntry_Changed" Unchecked="TriggerEntry_Changed" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid x:Name="ExternalTriggerFieldsPanel" Grid.Column="2" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="信号点位 / Tag" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="填写现场适配器可解析的稳定点位名，例如 PLC.Line1.PartPresent；不在这里写协议密码或连接串。" />
                                                </StackPanel>
                                                <TextBox x:Name="TriggerSignalTextBox" Height="36" Padding="10,6"
                                                         Text="{Binding SelectedInspectionItem.TriggerSignal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="RequiredField_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="触发条件" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="离散信号可按上升沿、下降沿、高电平或低电平触发；真实读取由后续 C# Trigger Adapter 实现。" />
                                                </StackPanel>
                                                <ComboBox x:Name="TriggerConditionComboBox" Height="36"
                                                          SelectedIndex="{Binding SelectedInspectionItem.TriggerConditionIndex, Mode=TwoWay}"
                                                          SelectionChanged="RequiredSelection_Changed">
                                                    <ComboBoxItem Content="上升沿" />
                                                    <ComboBoxItem Content="下降沿" />
                                                    <ComboBoxItem Content="高电平" />
                                                    <ComboBoxItem Content="低电平" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="执行参数" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="信号去抖（ms）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="忽略短于该时长的抖动信号；顺序或手动调用时保留该值但不参与触发。" />
                                            </StackPanel>
                                            <TextBox x:Name="TriggerDebounceTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.TriggerDebounceMsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="RequiredField_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="触发后延时（ms）" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="触发成立后等待工件和画面稳定，再取图并执行检测。" />
