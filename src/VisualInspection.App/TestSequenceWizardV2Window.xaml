<Window x:Class="VisualInspection.App.TestSequenceWizardV2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员 · 测试序列设置 V2（前端预览）"
        Width="1380" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="WizardStepButton" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="12,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="StepNumber"
                                           Text="{Binding Number}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="StepTitle"
                                           Grid.Row="1" Text="{Binding Title}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StepBadge"
                                           Grid.Row="2" Text="{Binding Badge}"
                                           FontSize="9"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="StepBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="#B8DDBF" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="已完成" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="正在设置" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="92" />
        </Style>

        <Style x:Key="SourceChoiceCard" TargetType="RadioButton">
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SourceCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="16,13">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedSourceGlyph" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource GreenDarkBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="SourceCardBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="SelectedSourceGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F4F5F4" />
                                <Setter Property="BorderBrush" Value="#D6DAD7" />
                                <Setter Property="Foreground" Value="#858D88" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="SourceCardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TestBlockModuleTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3,-1,0,0" />
        </Style>

        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#60706A" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="InspectionListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#26332E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#26332E" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SummaryRow" TargetType="Border">
            <Setter Property="Background" Value="#F8FAF8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="34" Background="{StaticResource GreenBrush}" CornerRadius="1" />
                    <StackPanel Margin="11,0,0,0">
                        <TextBlock Text="测试序列设置向导" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="一次只设置一件事，按顺序完成即可" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF6E8" BorderBrush="#E9D3A5" BorderThickness="1"
                        CornerRadius="3" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewModeText" Text="前端界面确认稿" FontSize="9" FontWeight="SemiBold" Foreground="#8A630B" />
                </Border>
                <Button x:Name="ClosePreviewButton" Grid.Column="2" Content="关闭预览" Click="Close_Click" Padding="12,5" FontSize="9" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="WizardStepsScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center"
                          Margin="22,16,22,10" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="WizardStepsItemsControl"
                              ItemsSource="{Binding Steps}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource WizardStepButton}"
                                    CommandParameter="{Binding Index}"
                                    Click="StepButton_Click"
                                    ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="22,18" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{StaticResource GreenPaleBrush}"
                                BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepNumberText" Text="1" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepTitleText" Text="填写项目信息" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentStepDescriptionText" Text="先确认这套检测配置属于哪个项目和工位。"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="每页只需完成当前内容" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid x:Name="BodyPanels" Grid.Row="1">
                    <Border x:Name="TestBlockStageBar" Visibility="Collapsed" Panel.ZIndex="20"
                            VerticalAlignment="Top" Height="60" Background="#FBFCFB"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="测试步设置" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" Margin="6,0" />
                                <TextBlock Text="{Binding SelectedInspectionItem.Name}" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="TestBlockModuleTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TestBlockBasicStageButton" Content="基本信息" Tag="0" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                                <Button x:Name="TestBlockTriggerStageButton" Content="自定义函数" Tag="3" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="34,28" Width="820" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="这套检测配置叫什么？" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="这些信息会显示在操作员工位页面，方便确认当前正在运行哪套检测。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,24" />
                            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="项目名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分不同产品或检测项目，并显示在操作员测试页面。" />
                                        </StackPanel>
                                        <TextBox x:Name="ProjectNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="工位名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="说明这套检测运行在哪个生产线或测试工位。" />
                                        </StackPanel>
                                        <TextBox x:Name="StationNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.Workstation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="测试序列名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="操作员开始测试时加载的检测流程名称。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="版本" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分同一测试流程的不同配置稿。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceVersionTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34,24" Width="1040" HorizontalAlignment="Center">
                            <TextBlock Text="图片或视频从哪里来？" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="图片文件夹与视频文件夹分开选择，当前只能选择其中一种；摄像头入口暂列为待开发。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,24" />
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="FolderSourceRadioButton" GroupName="InputSource" IsChecked="True"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后，操作台每录入一个序列号并点击开始，只读取文件夹中的下一张图片。">
                                    <StackPanel>
                                        <TextBlock Text="图片文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="浏览包含检测图片的文件夹" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="VideoFolderSourceRadioButton" GroupName="InputSource"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后浏览包含待检测视频的文件夹；本轮不接入视频读取逻辑。">
                                    <StackPanel>
                                        <TextBlock Text="视频文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="浏览包含检测视频的文件夹" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="UsbCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：当前版本不提供 USB 摄像头配置和连接。">
                                    <StackPanel>
                                        <TextBlock Text="USB 摄像头" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="11" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="IndustrialCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：厂商、SDK 和设备清单确认后再接入工业相机。">
                                    <StackPanel>
                                        <TextBlock Text="工业相机" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="11" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Border x:Name="FolderSourceSettingsPanel"
                                    Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="20" Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock x:Name="FolderSourceSettingsTitleText" Text="图片文件夹" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock x:Name="FolderSourceSettingsInfoGlyph" Style="{StaticResource InfoGlyph}" ToolTip="操作台每次录入一个序列号，只读取该文件夹中的下一张受支持图片。" />
                                        </StackPanel>
                                        <TextBox x:Name="FolderPathTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SourceAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                        <TextBlock x:Name="FolderSourceSettingsHintText"
                                                   Text="当前先确认图片文件夹选择界面；实际读取和检查逻辑留到功能开发阶段。"
                                                   FontSize="10" Foreground="{StaticResource GreenDarkBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BrowseSourceFolderButton" Grid.Column="1" Content="浏览文件夹"
                                            Click="BrowseSourceFolder_Click" Margin="14,20,0,0" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step3Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="34,16" Width="1060" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="建立项目模型库" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Text="一个项目可以连续添加多个模型；先在左侧选模型，再在右侧逐个完成设置。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="390" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelBorder}" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="模型列表" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="已添加 " FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Models.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                    <TextBlock Text=" 个模型" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="AddModelButton" Width="86" Height="30"
                                                        Click="AddModel_Click" Padding="7,2"
                                                        Background="White" BorderBrush="{StaticResource GreenDarkBrush}"
                                                        Foreground="{StaticResource GreenDarkBrush}"
                                                        ToolTip="继续向当前项目添加另一个模型；每个模型都有独立的名称、类型、文件和标签。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="添加模型" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="10" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RemoveSelectedModelButton" Width="96" Height="30" Margin="8,0,0,0"
                                                        Click="RemoveSelectedModel_Click" Padding="7,2"
                                                        Background="White" BorderBrush="#D9B8B5" Foreground="#A33A32"
                                                        AutomationProperties.Name="删除当前模型"
                                                        ToolTip="删除左侧当前选中的模型；模型已被测试步使用或仅剩一个模型时不可删除。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="删除当前" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="10" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <ListBox x:Name="ModelItemsList" Grid.Row="1" Margin="0,12,0,0"
                                                 ItemsSource="{Binding Models}"
                                                 ItemContainerStyle="{StaticResource InspectionListItem}"
                                                 BorderThickness="0" Background="Transparent"
                                                 SelectionChanged="ModelItemsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" Background="White" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="3">
                                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                                       Foreground="{StaticResource GreenDarkBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileName}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DetailsLabel}" FontSize="9" Foreground="{StaticResource GreenDarkBrush}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Grid.Row="2" Background="#F6F8F7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="3" Padding="10,8" Margin="0,10,0,0">
                                            <TextBlock Text="提示：先选中模型再删除；被测试步使用时需先改绑，项目至少保留 1 个模型。"
                                                       FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="当前模型设置" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="只需填写当前选中的模型，不会影响左侧其他模型。"
                                                           FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="模型名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="项目内用于识别模型的名称；建议写清检测对象或用途。" />
                                            </StackPanel>
                                            <TextBox Height="36" Padding="10,6"
                                                     Text="{Binding SelectedModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="任务类型" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="按模型实际用途选择；姿态 / 时序模型也在这里统一管理。" />
                                                </StackPanel>
                                                <ComboBox x:Name="ModelTaskTypeComboBox" Height="36"
                                                          SelectedIndex="{Binding SelectedModel.UiTypeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="目标检测" />
                                                    <ComboBoxItem Content="姿态 / 时序" />
                                                    <ComboBoxItem Content="图像分割" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="模型文件" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="每个模型单独选择一个 ONNX 或 PT 文件；当前前端阶段只展示流程。" />
                                                </StackPanel>
                                                <TextBox Height="36" Padding="10,6"
                                                         Text="{Binding SelectedModel.FileName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button x:Name="SelectModelFileButton" Grid.Column="3" Content="选择文件" Margin="8,20,0,0" VerticalAlignment="Top"
                                                    Click="SelectModelFile_Click"
                                                    ToolTip="从本机选择当前模型的 .onnx 或 .pt 文件。" />
                                        </Grid>

                                        <StackPanel Grid.Row="4" Margin="0,13,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                <TextBlock Text="标签 / 动作名称来源" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="优先自动读取；模型不带标签，或姿态动作需要自定义名称时，选择手动填写。" />
                                            </StackPanel>
                                            <ComboBox x:Name="LabelSourceComboBox" Height="36" SelectedIndex="{Binding SelectedModel.LabelSourceIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="自动识别（推荐）" />
                                                <ComboBoxItem Content="手动填写" />
                                            </ComboBox>
                                            <Border x:Name="ManualLabelEditorPanel" Margin="0,10,0,0" Padding="12" Background="#F6F8F7"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedModel.UseManualLabels}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="手动标签 / 动作名称" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBox Height="52" Margin="0,7,0,0" Padding="9,6" AcceptsReturn="True"
                                                             TextWrapping="Wrap" Text="{Binding SelectedModel.ManualLabelsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="使用逗号或换行分隔；本轮只展示编辑入口，正式解析在功能阶段接入。"
                                                               FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Row="5" Background="#F8FCF9" BorderBrush="#B8DDBF" BorderThickness="1"
                                                CornerRadius="4" Padding="13" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedModel.LabelPreviewTitle}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                <TextBlock Text="自动识别或手动填写的标签会显示在这里。"
                                                           FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                <ItemsControl ItemsSource="{Binding SelectedModel.Labels}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" BorderBrush="#B8DDBF" BorderThickness="1"
                                                                    CornerRadius="3" Padding="10,5" Margin="0,0,8,6">
                                                                <TextBlock Text="{Binding}" FontSize="10" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step4Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,54,0,0">
                        <Grid Margin="34,16" Width="1060" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="添加并排列测试步" FontSize="20" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="*" Foreground="#C62828" FontWeight="Bold" />
                                    <TextBlock Text=" 为必填项" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="3,1,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="测试步按照左侧列表从上到下依次执行；可使用上下箭头调整顺序。每个测试步内部再独立配置模型、Label、区域与判定条件。"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,12" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="470" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelBorder}" Padding="16" Background="#FBFCFB">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="测试步列表（从上到下执行）" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="列表顺序就是测试步执行顺序；可使用上下箭头调整。" />
                                                </StackPanel>
                                                <TextBlock x:Name="InspectionItemsSemanticsText" Text="执行顺序：从上到下" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Border Background="{StaticResource GreenPaleBrush}" CornerRadius="3" Padding="9,4" VerticalAlignment="Center">
                                                    <TextBlock Text="顺序执行" FontSize="9" Foreground="{StaticResource GreenDarkBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Button x:Name="AddInspectionItemButton" Width="74" Height="28" Margin="8,0,0,0"
                                                        Click="AddInspectionItem_Click" Padding="7,2"
                                                        Background="White" BorderBrush="{StaticResource GreenDarkBrush}"
                                                        Foreground="{StaticResource GreenDarkBrush}"
                                                        ToolTip="加号：在列表末尾新增测试步；新增后按当前列表顺序执行。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="添加" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="10" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListBox x:Name="InspectionItemsList" Grid.Row="1" Margin="0,10,0,0"
                                                 ItemsSource="{Binding InspectionItems}"
                                                 ItemContainerStyle="{StaticResource InspectionListItem}"
                                                 BorderThickness="0" Background="Transparent"
                                                 SelectionChanged="InspectionItemsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="102" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="2,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="{StaticResource GreenDarkBrush}" />
                                                                <TextBlock Text=" · " FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Text="{Binding RequiredLabel}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="↑" Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="13"
                                                                    CommandParameter="{Binding}" Click="MoveInspectionItemUp_Click"
                                                                    ToolTip="上移：提前这个测试步的执行顺序" />
                                                            <Button Content="↓" Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="13"
                                                                    CommandParameter="{Binding}" Click="MoveInspectionItemDown_Click"
                                                                    ToolTip="下移：延后这个测试步的执行顺序" />
                                                            <Button Content="&#xE738;" Style="{StaticResource IconButton}"
                                                                    CommandParameter="{Binding}" Click="RemoveInspectionItem_Click"
                                                                    ToolTip="减号：删除这个测试步" Foreground="#A33A32" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="当前测试步 · 基本信息" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="在这里设置名称、检测类型、模型，以及各 Label 的区域和判定。" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Button x:Name="RemoveSelectedInspectionItemButton" Grid.Column="1" Width="30" Height="28" Margin="8,0,0,0"
                                                    Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                    Foreground="#A33A32" Padding="0" Click="RemoveSelectedInspectionItem_Click"
                                                    ToolTip="减号：删除右侧当前正在编辑的测试步。" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,13,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="测试步名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="这是现场调用和日志中显示的功能名称，应能直接说明该测试步检查什么。" />
                                            </StackPanel>
                                            <TextBox x:Name="ItemNameTextBox" Height="36" Padding="10,6"
                                                     Text="{Binding SelectedInspectionItem.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="检测类型" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="目标检测与图像分割都按单张图配置 Label、整图/ROI 与判定条件；姿态动作判断连续帧中的动作顺序。" />
                                                </StackPanel>
                                                <ComboBox x:Name="InspectionTypeComboBox" Height="36" SelectedIndex="{Binding SelectedInspectionItem.TypeIndex, Mode=TwoWay}"
                                                          SelectionChanged="InspectionTypeComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="目标检测（单张图）" />
                                                    <ComboBoxItem Content="姿态动作（连续帧）" />
                                                    <ComboBoxItem Content="图像分割（单张图）" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="是否必选" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="必选项必须通过，整个 Test Run 才能通过；可选项仅记录结果。" />
                                                </StackPanel>
                                                <CheckBox Content="设为必选项" IsChecked="{Binding SelectedInspectionItem.IsRequired, Mode=TwoWay}"
                                                          Height="36" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="3" Margin="0,11,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="绑定模型" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="指定这一测试步实际调用哪个模型；不同测试步可以绑定不同模型。" />
                                            </StackPanel>
                                            <ComboBox x:Name="InspectionModelComboBox" Height="36"
                                                      ItemsSource="{Binding CompatibleInspectionModels}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedInspectionItem.Model, Mode=OneWay}"
                                                      SelectionChanged="InspectionModelComboBox_SelectionChanged"
                                                      DropDownOpened="InspectionModelComboBox_DropDownOpened"
                                                      DropDownClosed="InspectionModelComboBox_DropDownClosed" />
                                            <TextBlock x:Name="InspectionModelStatusText"
                                                       FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>

                                        <StackPanel x:Name="NormalDetectionSetupPanel" Grid.Row="4" Margin="0,12,0,0">
                                            <Border Background="#F8FCF9" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="13">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="检测内容与判定条件" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                        <TextBlock Text="每个 Label 独立配置区域与判定；保存一个后可继续设置下一个。"
                                                                   FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Button x:Name="OpenDetectionEditorButton" Grid.Column="1" Content="+ 添加检测子项"
                                                            Click="OpenDetectionEditor_Click" Padding="12,5"
                                                            Background="White" BorderBrush="{StaticResource GreenDarkBrush}"
                                                            Foreground="{StaticResource GreenDarkBrush}" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl x:Name="DetectionChildrenItemsControl"
                                                          ItemsSource="{Binding SelectedInspectionItem.DetectionChildren}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                                                                Padding="10" Margin="0,0,0,6" Background="White">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="70" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="Label" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="检测区域" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <TextBlock Text="{Binding ScopeSummary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="判定条件" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                                    <TextBlock Text="{Binding RuleSummary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
