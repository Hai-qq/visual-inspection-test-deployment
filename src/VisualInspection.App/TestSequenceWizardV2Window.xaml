<Window x:Class="VisualInspection.App.TestSequenceWizardV2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员 · 测试序列设置"
        Width="1380" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="WizardStepButton" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="12,9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="StepNumber"
                                           Text="{Binding Number}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="StepTitle"
                                           Grid.Row="1" Text="{Binding Title}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="StepBadge"
                                           Grid.Row="2" Text="{Binding Badge}"
                                           FontSize="9"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="StepBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="#B8DDBF" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="已完成" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="正在设置" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="92" />
        </Style>

        <Style x:Key="SourceChoiceCard" TargetType="RadioButton">
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SourceCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="16,13">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedSourceGlyph" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource GreenDarkBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="SourceCardBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="SelectedSourceGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F4F5F4" />
                                <Setter Property="BorderBrush" Value="#D6DAD7" />
                                <Setter Property="Foreground" Value="#858D88" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="SourceCardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TestBlockModuleTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3,-1,0,0" />
        </Style>

        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#60706A" />
            <Setter Property="Margin" Value="4,-3,0,-3" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.Placement" Value="MousePoint" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="InspectionListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#26332E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#26332E" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SummaryRow" TargetType="Border">
            <Setter Property="Background" Value="#F8FAF8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="34" Background="{StaticResource GreenBrush}" CornerRadius="1" />
                    <StackPanel Margin="11,0,0,0">
                        <TextBlock Text="测试序列设置向导" FontSize="16" FontWeight="SemiBold"
                                   ToolTip="按顶部步骤依次完成设置，最后可直接应用到当前操作台，也可另行导出 sequence 与对应模型。" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF6E8" BorderBrush="#E9D3A5" BorderThickness="1"
                        CornerRadius="3" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewModeText" Text="sequence 设置、应用与导出" FontSize="9" FontWeight="SemiBold" Foreground="#8A630B" />
                </Border>
                <Button x:Name="ClosePreviewButton" Grid.Column="2" Content="关闭预览" Click="Close_Click" Padding="12,5" FontSize="9" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="WizardStepsScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center"
                          Margin="22,16,22,10" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="WizardStepsItemsControl"
                              ItemsSource="{Binding Steps}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource WizardStepButton}"
                                    CommandParameter="{Binding Index}"
                                    Click="StepButton_Click"
                                    ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="22,18" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{StaticResource GreenPaleBrush}"
                                BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepNumberText" Text="1" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepTitleText" Text="填写项目信息" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentStepDescriptionText" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="ⓘ" Style="{StaticResource InfoGlyph}" VerticalAlignment="Center"
                                   ToolTip="红色 * 为必填项；其他说明请悬停信息图标查看。" />
                    </Grid>
                </Border>

                <Grid x:Name="BodyPanels" Grid.Row="1">
                    <Border x:Name="TestBlockStageBar" Visibility="Collapsed" Panel.ZIndex="20"
                            VerticalAlignment="Top" Height="60" Background="#FBFCFB"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="测试步设置" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" Margin="6,0" />
                                <TextBlock Text="{Binding SelectedInspectionItem.Name}" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="TestBlockModuleTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TestBlockBasicStageButton" Content="基本信息" Tag="0" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                                <Button x:Name="TestBlockTriggerStageButton" Content="自定义函数" Tag="3" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="34,28" Width="820" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="这套检测配置叫什么？" Visibility="Collapsed"
                                       ToolTip="项目、工位和型号会显示在操作员工位页面。" />
                            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="项目名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分不同产品或检测项目，并显示在操作员测试页面。" />
                                        </StackPanel>
                                        <TextBox x:Name="ProjectNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="工位名称" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="说明这套检测运行在哪个生产线或测试工位。" />
                                        </StackPanel>
                                        <TextBox x:Name="StationNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.Workstation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="型号" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="每个 sequence 只检测一种产品；这里填写该产品型号。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="版本" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分同一测试流程的不同配置稿。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceVersionTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34,24" Width="1040" HorizontalAlignment="Center">
                            <TextBlock Text="图片或视频从哪里来？" Visibility="Collapsed"
                                       ToolTip="图片文件夹与视频文件夹分开选择，当前只能选择其中一种；摄像头入口保持适配器门禁。" />
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="FolderSourceRadioButton" GroupName="InputSource" IsChecked="True"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后，操作台每次读取文件夹中的下一张图片，并将图片主文件名作为产品序列号。">
                                    <StackPanel>
                                        <TextBlock Text="图片文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="浏览包含检测图片的文件夹" Visibility="Collapsed" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="VideoFolderSourceRadioButton" GroupName="InputSource"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后浏览包含待检测视频的文件夹；本轮不接入视频读取逻辑。">
                                    <StackPanel>
                                        <TextBlock Text="视频文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="浏览包含检测视频的文件夹" Visibility="Collapsed" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="UsbCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：当前版本不提供 USB 摄像头配置和连接。">
                                    <StackPanel>
                                        <TextBlock Text="USB 摄像头" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="11" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="IndustrialCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：厂商、SDK 和设备清单确认后再接入工业相机。">
                                    <StackPanel>
                                        <TextBlock Text="工业相机" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="11" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Border x:Name="FolderSourceSettingsPanel"
                                    Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="20" Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock x:Name="FolderSourceSettingsTitleText" Text="图片文件夹" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock x:Name="FolderSourceSettingsInfoGlyph" Style="{StaticResource InfoGlyph}" ToolTip="操作台每次录入一个序列号，只读取该文件夹中的下一张受支持图片。" />
                                        </StackPanel>
                                        <TextBox x:Name="FolderPathTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SourceAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                        <TextBlock x:Name="FolderSourceSettingsHintText" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="BrowseSourceFolderButton" Grid.Column="1" Content="选择图源文件夹"
                                            MinWidth="126" Padding="12,5"
                                            Click="BrowseSourceFolder_Click" Margin="14,20,0,0" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step3Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="34,16" Width="1060" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="建立项目模型库" Visibility="Collapsed"
                                       ToolTip="一个项目可以连续添加多个模型；先在左侧选模型，再在右侧逐个完成设置。模型也可全部删除。" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="390" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelBorder}" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
