                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="292" Background="#FBFCFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
