<Window x:Class="VisualInspection.App.TestSequenceWizardV2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员 · 测试序列设置"
        Width="1380" Height="860" MinWidth="1120" MinHeight="720"
        FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/></Style>

        <Style x:Key="WizardStepButton" TargetType="Button">
            <Setter Property="Width" Value="154" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BCC8BF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="StepNumber" Text="{Binding Number}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StepTitle" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StepBadge" Text="{Binding Badge}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                <Setter TargetName="StepBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="#B8DDBF" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="已完成" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="StepNumber" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="StepBadge" Property="Text" Value="正在设置" />
                                <Setter TargetName="StepBadge" Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="92" />
        </Style>

        <Style x:Key="SourceChoiceCard" TargetType="RadioButton">
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SourceCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid Margin="16,13">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedSourceGlyph" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource GreenDarkBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="SourceCardBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SourceCardBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="SelectedSourceGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F4F5F4" />
                                <Setter Property="BorderBrush" Value="#D6DAD7" />
                                <Setter Property="Foreground" Value="#858D88" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="SourceCardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TestBlockModuleTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3,-1,0,0" />
        </Style>

        <Style x:Key="InfoGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#60706A" />
            <Setter Property="Margin" Value="4,-3,0,-3" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.Placement" Value="MousePoint" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" /><Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
        </Style>

        <Style x:Key="InspectionListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8ABF95" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FCF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GreenDarkBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GreenPaleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#26332E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#26332E" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SummaryRow" TargetType="Border">
            <Setter Property="Background" Value="#F8FAF8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="Auto" MinHeight="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="34" Background="{StaticResource GreenBrush}" CornerRadius="1" />
                    <StackPanel Margin="11,0,0,0">
                        <TextBlock Text="测试序列设置向导" FontSize="16" FontWeight="SemiBold"
                                   ToolTip="按顶部步骤依次完成设置，最后可直接应用到当前操作台，也可另行导出 sequence 与对应模型。" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF6E8" BorderBrush="#E9D3A5" BorderThickness="1"
                        CornerRadius="3" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewModeText" Text="sequence 设置、应用与导出" FontSize="12" FontWeight="SemiBold" Foreground="#8A630B" />
                </Border>
                <Button x:Name="ClosePreviewButton" Grid.Column="2" Content="关闭预览" Click="Close_Click" Padding="12,5" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FBFCFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="WizardStepsScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          Margin="16,10" PanningMode="HorizontalOnly">
                <ItemsControl x:Name="WizardStepsItemsControl"
                              ItemsSource="{Binding Steps}"
                              HorizontalAlignment="Center" Margin="0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource WizardStepButton}"
                                    CommandParameter="{Binding Index}"
                                    Click="StepButton_Click"
                                    ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Margin="16,10" Style="{StaticResource PanelBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{StaticResource GreenPaleBrush}"
                                BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepNumberText" Text="1" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentStepTitleText" Text="填写项目信息" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentStepDescriptionText" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource InfoGlyph}" VerticalAlignment="Center"
                                   ToolTip="红色 * 为必填项；其他说明请悬停信息图标查看。" />
                    </Grid>
                </Border>

                <Grid x:Name="BodyPanels" Grid.Row="1">
                    <Border x:Name="TestBlockStageBar" Visibility="Collapsed" Panel.ZIndex="20"
                            VerticalAlignment="Top" Height="48" Background="#FBFCFB"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="测试步设置 · " FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedInspectionItem.Name}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedInspectionItem.Name}" />
                            </Grid>
                            <StackPanel x:Name="TestBlockModuleTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TestBlockBasicStageButton" Content="基本信息" Tag="0" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                                <Button x:Name="TestBlockTriggerStageButton" Content="自定义函数" Tag="3" Width="132" Click="TestBlockStageButton_Click" Style="{StaticResource TestBlockModuleTabButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24,20" MaxWidth="1040" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="这套检测配置叫什么？" Visibility="Collapsed"
                                       ToolTip="项目、工位和型号会显示在操作员工位页面。" />
                            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="项目名称" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分不同产品或检测项目，并显示在操作员测试页面。" />
                                        </StackPanel>
                                        <TextBox x:Name="ProjectNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="工位名称" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="说明这套检测运行在哪个生产线或测试工位。" />
                                        </StackPanel>
                                        <TextBox x:Name="StationNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.Workstation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="型号" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="每个 sequence 只检测一种产品；这里填写该产品型号。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceNameTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="版本" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="用于区分同一测试流程的不同配置稿。" />
                                        </StackPanel>
                                        <TextBox x:Name="SequenceVersionTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SequenceVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="Step2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20" MaxWidth="1240" HorizontalAlignment="Stretch">
                            <TextBlock Text="图片或视频从哪里来？" Visibility="Collapsed"
                                       ToolTip="图片文件夹与视频文件夹分开选择，当前只能选择其中一种；摄像头入口保持适配器门禁。" />
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="FolderSourceRadioButton" GroupName="InputSource" IsChecked="True"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后，操作台每次读取文件夹中的下一张图片，并将图片主文件名作为产品序列号。">
                                    <StackPanel>
                                        <TextBlock Text="图片文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="浏览包含检测图片的文件夹" Visibility="Collapsed" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="VideoFolderSourceRadioButton" GroupName="InputSource"
                                             Checked="SourceSelection_Changed"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="选择后浏览包含待检测视频的文件夹；本轮不接入视频读取逻辑。">
                                    <StackPanel>
                                        <TextBlock Text="视频文件夹" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="运行待接入" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="UsbCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：当前版本不提供 USB 摄像头配置和连接。">
                                    <StackPanel>
                                        <TextBlock Text="USB 摄像头" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="12" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="IndustrialCameraSourceRadioButton" GroupName="InputSource"
                                             IsEnabled="False"
                                             Style="{StaticResource SourceChoiceCard}"
                                             ToolTip="待开发：厂商、SDK 和设备清单确认后再接入工业相机。">
                                    <StackPanel>
                                        <TextBlock Text="工业相机" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="待开发" FontSize="12" FontWeight="SemiBold" Foreground="#7E8781" Margin="0,7,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Border x:Name="FolderSourceSettingsPanel"
                                    Style="{StaticResource PanelBorder}" Background="#FBFCFB" Padding="20" Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock x:Name="FolderSourceSettingsTitleText" Text="图片文件夹" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Style="{StaticResource RequiredStar}" />
                                            <TextBlock x:Name="FolderSourceSettingsInfoGlyph" Style="{StaticResource InfoGlyph}" ToolTip="操作台每次点击开始，只读取该文件夹中的下一张受支持图片，并使用图片文件名作为序列号。" />
                                        </StackPanel>
                                        <TextBox x:Name="FolderPathTextBox" Height="36" Padding="10,6"
                                                 Text="{Binding Editor.SourceAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RequiredField_TextChanged" />
                                        <TextBlock x:Name="FolderSourceSettingsHintText" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="BrowseSourceFolderButton" Grid.Column="1" Content="选择图源文件夹"
                                            MinWidth="126" Padding="12,5"
                                            Click="BrowseSourceFolder_Click" Margin="14,20,0,0" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="Step3Panel" Visibility="Collapsed">
                        <Grid Margin="16,12" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="建立项目模型库" Visibility="Collapsed"
                                       ToolTip="一个项目可以连续添加多个模型；先在左侧选模型，再在右侧逐个完成设置。模型也可全部删除。" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource PanelBorder}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="模型列表" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="已添加 " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding Models.Count}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                    <TextBlock Text=" 个模型" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="AddModelButton" Width="86" Height="30"
                                                        Click="AddModel_Click" Padding="7,2"
                                                        Background="White" BorderBrush="{StaticResource GreenDarkBrush}"
                                                        Foreground="{StaticResource GreenDarkBrush}"
                                                        ToolTip="继续向当前项目添加另一个模型；每个模型都有独立的名称、类型、文件和标签。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="添加模型" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RemoveSelectedModelButton" Width="96" Height="30" Margin="8,0,0,0"
                                                        Click="RemoveSelectedModel_Click" Padding="7,2"
                                                        Background="White" BorderBrush="#D9B8B5" Foreground="#A33A32"
                                                        AutomationProperties.Name="删除当前模型"
                                                        ToolTip="删除左侧当前选中的模型；若测试步绑定了它，相应测试步会一并移除。模型库允许为空。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="删除当前" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <ListBox x:Name="ModelItemsList" Grid.Row="1" Margin="0,12,0,0"
                                                 ItemsSource="{Binding Models}"
                                                 ItemContainerStyle="{StaticResource InspectionListItem}"
                                                 BorderThickness="0" Background="Transparent"
                                                 SelectionChanged="ModelItemsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" Background="White" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="3">
                                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                                       Foreground="{StaticResource GreenDarkBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FileName}" />
                                                            <TextBlock Text="{Binding DetailsLabel}" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="ModelSettingsScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Border Style="{StaticResource PanelBorder}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Visibility="Collapsed">
                                                <TextBlock Text="当前模型设置" Style="{StaticResource SectionTitle}"
                                                           ToolTip="这里只修改左侧当前选中的模型。" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="模型名称" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="项目内用于识别模型的名称；建议写清检测对象或用途。" />
                                            </StackPanel>
                                            <TextBox Height="36" Padding="10,6"
                                                     Text="{Binding SelectedModel.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="任务类型" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="按模型实际用途选择；姿态 / 时序模型也在这里统一管理。" />
                                                </StackPanel>
                                                <ComboBox x:Name="ModelTaskTypeComboBox" Height="36"
                                                          SelectedIndex="{Binding SelectedModel.UiTypeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="目标检测" />
                                                    <ComboBoxItem Content="姿态 / 时序" />
                                                    <ComboBoxItem Content="图像分割" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="模型文件" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Style="{StaticResource RequiredStar}" />
                                                    <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="每个模型单独选择一个 ONNX 或 PT 文件；导出时会复制测试步实际引用的模型并校验 SHA-256。" />
                                                </StackPanel>
                                                <TextBox Height="36" Padding="10,6"
                                                         Text="{Binding SelectedModel.FileName, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button x:Name="SelectModelFileButton" Grid.Column="3" Content="选择模型文件" MinWidth="112" Padding="12,5"
                                                    Margin="8,20,0,0" VerticalAlignment="Top"
                                                    Click="SelectModelFile_Click"
                                                    ToolTip="从本机选择当前模型的 .onnx 或 .pt 文件。" />
                                        </Grid>

                                        <Grid Grid.Row="4" Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="新增标签 / 动作" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="选择 ONNX 后会尝试自动读取标签；可直接改名，也可输入新名称后点击加号。" />
                                            </StackPanel>
                                                <TextBox x:Name="NewModelLabelTextBox" Grid.Column="1" Height="36" Padding="10,6"
                                                         ToolTip="输入一个新标签名称，然后点击加号。" />
                                                <Button x:Name="AddModelLabelButton" Grid.Column="2" Content="＋" Width="42" Height="36" Margin="8,0,0,0"
                                                        Click="AddModelLabel_Click" ToolTip="添加标签" />
                                        </Grid>

                                        <Border Grid.Row="5" Background="#F8FCF9" BorderBrush="#B8DDBF" BorderThickness="1"
                                                CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedModel.LabelPreviewTitle}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                <ItemsControl x:Name="ModelLabelsItemsControl" ItemsSource="{Binding SelectedModel.Labels}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" BorderBrush="#B8DDBF" BorderThickness="1"
                                                                    CornerRadius="3" Padding="7,4" Margin="0,0,8,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBox Text="{Binding Mode=OneWay}" Tag="{Binding}" ToolTip="{Binding}"
                                                                             MinWidth="160" MaxWidth="300" Padding="2,4" BorderThickness="0" Background="Transparent"
                                                                             LostFocus="ModelLabelTextBox_LostFocus" />
                                                                    <Button Content="－" Width="28" Height="24" Padding="0" Margin="5,0,0,0"
                                                                            CommandParameter="{Binding}" Click="RemoveModelLabel_Click"
                                                                            ToolTip="删除这个标签" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="Step4Panel" Visibility="Collapsed" Margin="0,48,0,0">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelBorder}" Padding="12" Background="#FBFCFB">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="测试步列表" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="InspectionItemsSemanticsText" Text="从上到下依次执行" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="AddInspectionItemButton" Grid.Column="1" Content="＋ 添加" Padding="12,6" Margin="8,0,0,0"
                                                Click="AddInspectionItem_Click" Foreground="{StaticResource GreenDarkBrush}" BorderBrush="{StaticResource GreenDarkBrush}"
                                                ToolTip="在列表末尾新增测试步；使用上下箭头调整执行顺序。"/>
                                    </Grid>
                                    <ListBox x:Name="InspectionItemsList" Grid.Row="1" Margin="0,12,0,0"
                                             ItemsSource="{Binding InspectionItems}" ItemContainerStyle="{StaticResource InspectionListItem}"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="InspectionItemsList_SelectionChanged">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid MinHeight="54">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="↑" Style="{StaticResource IconButton}" FontFamily="Segoe UI" CommandParameter="{Binding}" Click="MoveInspectionItemUp_Click" ToolTip="上移测试步"/>
                                                        <Button Content="↓" Style="{StaticResource IconButton}" FontFamily="Segoe UI" CommandParameter="{Binding}" Click="MoveInspectionItemDown_Click" ToolTip="下移测试步"/>
                                                        <Button Content="&#xE738;" Style="{StaticResource IconButton}" CommandParameter="{Binding}" Click="RemoveInspectionItem_Click" ToolTip="删除测试步" Foreground="#A33A32"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid x:Name="InspectionBasicFields">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="测试步名称" FontSize="13"/><TextBlock Style="{StaticResource RequiredStar}"/></StackPanel>
                                            <TextBox x:Name="ItemNameTextBox" Height="36" Padding="10,6" Text="{Binding SelectedInspectionItem.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="检测类型" FontSize="13"/><TextBlock Style="{StaticResource RequiredStar}"/>
                                                <TextBlock x:Name="InspectionTypeInfoGlyph" Style="{StaticResource InfoGlyph}" ToolTip="目标检测与图像分割配置单张图规则；姿态动作检查连续帧中的动作顺序。"/>
                                            </StackPanel>
                                            <ComboBox x:Name="InspectionTypeComboBox" Height="36" SelectedIndex="{Binding SelectedInspectionItem.TypeIndex, Mode=TwoWay}" SelectionChanged="InspectionTypeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="目标检测（单张图）"/><ComboBoxItem Content="姿态动作（连续帧）"/><ComboBoxItem Content="图像分割（单张图）"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="绑定模型 *" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox x:Name="InspectionModelNameTextBox" Grid.Column="1" Height="36" Padding="10,6" IsReadOnly="True" Text="{Binding SelectedInspectionItem.Model.Name, Mode=OneWay}"/>
                                            <Button x:Name="ChooseInspectionModelButton" Grid.Column="2" Content="选择模型" Padding="12,6" Margin="8,0,0,0" Click="ChooseInspectionModel_Click" ToolTip="选择当前测试步使用的兼容模型。"/>
                                        </Grid>
                                        <TextBlock x:Name="InspectionModelStatusText" Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        <Button x:Name="RemoveSelectedInspectionItemButton" Visibility="Collapsed" Content="删除测试步" Click="RemoveSelectedInspectionItem_Click" ToolTip="删除当前正在编辑的测试步。"/>
                                    </Grid>
                                    <Grid x:Name="NormalDetectionSetupPanel" Grid.Row="2">
                                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="检测标签与判定条件" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource GreenDarkBrush}"/>
                                            <Button x:Name="OpenDetectionEditorButton" Grid.Column="1" Content="＋ 添加检测标签" Click="OpenDetectionEditor_Click" Padding="12,6" Foreground="{StaticResource GreenDarkBrush}" BorderBrush="{StaticResource GreenDarkBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Background="#EEF3F0" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="检测标签" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="检测区域" Grid.Column="1" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="判定条件" Grid.Column="2" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Text="操作" Grid.Column="3" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <ScrollViewer x:Name="DetectionChildrenScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="DetectionChildrenItemsControl" ItemsSource="{Binding SelectedInspectionItem.DetectionChildren}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border BorderBrush="#E4E9E5" BorderThickness="0,0,0,1" Padding="0,3" MinHeight="40">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Margin="10,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ScopeSummary}" Grid.Column="1" FontSize="13" Margin="0,0,8,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding RuleSummary}" Grid.Column="2" FontSize="13" Margin="0,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Button Content="&#xE70F;" Style="{StaticResource IconButton}" CommandParameter="{Binding}" Click="EditDetectionChild_Click" ToolTip="编辑当前标签"/>
                                                                <Button Content="&#xE738;" Style="{StaticResource IconButton}" CommandParameter="{Binding}" Click="RemoveDetectionChild_Click" ToolTip="删除当前标签" Foreground="#A33A32"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    <Border x:Name="PoseBasicInfoHint" Grid.Row="2" Visibility="Collapsed"
                                                Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1"
                                                CornerRadius="4" Padding="11" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="动作顺序摘要" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}"
                                                                   ToolTip="首次选择姿态或时序模型时弹出配置；保存后可重新编辑。" />
                                                    </StackPanel>
                                                    <Button x:Name="EditPoseActionsButton" Grid.Column="1" Content="重新编辑动作顺序"
                                                            Click="OpenPoseActionEditor_Click" Padding="12,5" Margin="12,0,0,0"
                                                            Background="White" BorderBrush="{StaticResource GreenDarkBrush}"
                                                            Foreground="{StaticResource GreenDarkBrush}" />
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding PoseSteps}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" BorderBrush="#B8DDBF" BorderThickness="1"
                                                                    CornerRadius="3" Padding="9,5" Margin="0,0,7,5">
                                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="Step6Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,48,0,0">
                        <StackPanel Margin="24,16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Text="设置当前测试步的通过条件" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"
                                       ToolTip="系统会按检测类型显示数量判断或姿态时序参数，并生成判定摘要。" />
                            <Border Background="{StaticResource GreenPaleBrush}" BorderBrush="#B8DDBF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="正在设置：" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedInspectionItem.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                    <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SelectedInspectionItem.TypeLabel}" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="TargetRulePanel">
                                <Border Style="{StaticResource PanelBorder}" Padding="22">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="检测目标" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="选择本条规则要统计的目标标签。" />
                                            </StackPanel>
                                            <ComboBox x:Name="TargetRuleTargetComboBox" Height="36"
                                                      ItemsSource="{Binding SelectedInspectionItem.Model.Labels}"
                                                      SelectedItem="{Binding SelectedInspectionItem.TargetLabel, Mode=TwoWay}"
                                                      SelectionChanged="RequiredSelection_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="判断方式" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Style="{StaticResource RequiredStar}" />
                                                <TextBlock Style="{StaticResource InfoGlyph}" ToolTip="数量等于适合完整性检查；数量范围适合允许波动；数量大于适合瑕疵大于 0 即失败等场景。" />
