<Window x:Class="VisualInspection.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VisualInspection.App.Controls"
        mc:Ignorable="d"
        Title="视觉检测测试部署系统"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="OperatorActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#425149" BlurRadius="2" ShadowDepth="2" Opacity="0.22" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#425149" BlurRadius="1" ShadowDepth="0" Opacity="0.14" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OperatorPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource OperatorActionButton}">
            <Setter Property="Background" Value="{StaticResource GreenDarkBrush}" />
            <Setter Property="BorderBrush" Value="#1B672D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="OperatorStopActionButton" TargetType="Button" BasedOn="{StaticResource OperatorActionButton}">
            <Setter Property="Background" Value="#FFF3F3" />
            <Setter Property="BorderBrush" Value="#D99A97" />
            <Setter Property="Foreground" Value="{StaticResource FailBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="34" Background="{StaticResource GreenBrush}"/>
                    <StackPanel Margin="10,0,0,0"><TextBlock Text="视觉检测" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="操作员工作台" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding SequenceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SequenceName}"/>
                    <TextBlock Text="{Binding ProjectName}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectName}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderAdminActionsPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportSequenceButton" MinWidth="116" Content="导入测试序列" Click="ImportSequence_Click" IsEnabled="{Binding CanImportSequence}" Margin="0,0,8,0" Padding="12,8" FontSize="13" ToolTip="导入 *.sequence.json 及对应模型。"/>
                    <Button x:Name="SequenceSettingsButton" MinWidth="116" Content="测试序列设置" Click="SequenceSettings_Click" IsEnabled="{Binding CanOpenSettings}" Visibility="{Binding SettingsVisibility}" Margin="0,0,16,0" Padding="12,8" FontSize="13"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="160"><TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" ToolTip="{Binding RoleName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentTime}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="174"/></Grid.RowDefinitions>
            <!-- Test sequence -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="140" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <TextBlock Text="测试序列" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GreenPaleBrush}" Padding="7,3" CornerRadius="9">
                                <TextBlock Text="{Binding ItemCountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="尚未加载测试序列" Visibility="{Binding EmptySequenceVisibility}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="16,24" TextWrapping="Wrap"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sequence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                                    Background="{Binding ResultBrush}">
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="Bold" Margin="0,6,0,0"
                                                           Foreground="{Binding ResultBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartActionButton" Grid.Row="0" Grid.ColumnSpan="3" Command="{Binding StartCommand}"
                                Style="{StaticResource OperatorPrimaryActionButton}"
                                AutomationProperties.Name="开始"
                                ToolTip="文件夹图源直接检测下一张图片，并以图片主文件名作为序列号；相机图源会先弹窗录入序列号。">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                                    <Path Data="M 2,1 L 15,8 L 2,15 Z" Fill="White" />
                                </Viewbox>
                                <TextBlock x:Name="StartActionText" Text="开始" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopActionButton" Grid.Row="2" Grid.Column="0" Command="{Binding StopCommand}"
                                Style="{StaticResource OperatorStopActionButton}" AutomationProperties.Name="停止">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="13" Height="13" RadiusX="1" RadiusY="1"
                                           Fill="{StaticResource FailBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="StopActionText" Text="停止" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetActionButton" Grid.Row="2" Grid.Column="2" Command="{Binding ResetCommand}"
                                Style="{StaticResource OperatorActionButton}" AutomationProperties.Name="复位">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                                    <Path Data="M 14,5 A 6,6 0 1 0 15,10 M 14,5 L 14,1 M 14,5 L 10,5"
                                          Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock x:Name="ResetActionText" Text="复位" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>


            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" ClipToBounds="True">
                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SourceName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputSourceStatus}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ImageStatusLabel}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" x:Name="InspectionViewport"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F3F6F4"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing Geometry="M 24,0 L 0,0 0,24"><GeometryDrawing.Pen><Pen Brush="#DDE5DF" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Grid.Background><Image x:Name="InspectionImage" Source="{Binding CurrentImage}" Stretch="Uniform" Margin="8"/><Border x:Name="EmptySequencePanel" Visibility="{Binding EmptySequenceVisibility}" Background="#F9FCFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28" MaxWidth="460" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="尚未加载测试序列" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="导入 Sequence 文件后，显示对应型号、测试步和判定规则。" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,20"/><Button Content="导入测试序列" Click="ImportSequence_Click" IsEnabled="{Binding CanImportSequence}" Style="{StaticResource OperatorPrimaryActionButton}" HorizontalAlignment="Center" Padding="20,10"/></StackPanel></Border></Grid>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"><Grid>
                        <TextBlock Text="全局统计" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="当前会话" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid></Border>
                    <Grid x:Name="StatisticsBodyPanel" Grid.Row="1" Margin="9,6" MaxHeight="380" VerticalAlignment="Top">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="64"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.Column="0" Margin="2" Padding="8,5" Background="#F2F6F4" CornerRadius="3"><StackPanel>
 <TextBlock Text="有效检测" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
 <TextBlock Text="{Binding Statistics.TotalCount}" FontSize="24" FontWeight="SemiBold" Foreground="#20392E" /></StackPanel></Border><Border Grid.Row="0" Grid.Column="1" Margin="2" Padding="8,5" Background="#FFF6E9" CornerRadius="3"><StackPanel>
 <TextBlock Text="错误" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
 <TextBlock Text="{Binding Statistics.ErrorCount}" FontSize="24" FontWeight="SemiBold" Foreground="#99680C" /></StackPanel></Border><Border Grid.Row="1" Grid.Column="0" Margin="2" Padding="8,5" Background="#EDF8F3" CornerRadius="3"><StackPanel>
 <TextBlock Text="通过" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
 <TextBlock Text="{Binding Statistics.PassCount}" FontSize="24" FontWeight="SemiBold" Foreground="#00704A" /></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Margin="2" Padding="8,5" Background="#FFF1F1" CornerRadius="3"><StackPanel>
 <TextBlock Text="不通过" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
 <TextBlock Text="{Binding Statistics.FailCount}" FontSize="24" FontWeight="SemiBold" Foreground="#C9403A" /></StackPanel></Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,8">
                                <RadioButton Content="数量" FontSize="13" GroupName="StatisticsMode" IsChecked="{Binding Statistics.IsCountMode}" Margin="0,0,18,0"/>
                                <RadioButton x:Name="QualificationRateModeRadioButton" Content="合格率" FontSize="13" GroupName="StatisticsMode" IsChecked="{Binding Statistics.IsRateMode}"/>
                            </StackPanel>
                            <Grid Grid.Row="2" MaxHeight="162" VerticalAlignment="Top" Visibility="{Binding Statistics.IsCountMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Viewbox x:Name="CountChartViewbox" Stretch="Uniform" MaxHeight="138" MaxWidth="138">
                                    <controls:PassFailPieChart Width="138" Height="138" PassCount="{Binding Statistics.PassCount}" FailCount="{Binding Statistics.FailCount}" ToolTip="通过 / 不通过分布"/>
                                </Viewbox>
                                    <TextBlock Text="暂无检测结果" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Statistics.TotalCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                <TextBlock Grid.Row="1" Text="通过 / 不通过分布" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                            </Grid>
                            <Grid Grid.Row="2" MaxHeight="162" VerticalAlignment="Top" Visibility="{Binding Statistics.IsRateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="QualificationRateTitleText" Text="合格率" FontSize="12" HorizontalAlignment="Center"/>
                                <Viewbox x:Name="RateChartViewbox" Grid.Row="1" Stretch="Uniform" MaxHeight="138" MaxWidth="138"><controls:DonutChart Width="138" Height="138" PassRate="{Binding Statistics.PassRate}" CenterText="{Binding Statistics.PassRateText}"/></Viewbox>
                            </Grid>
                            <TextBlock Grid.Row="3" Text="错误单独记录，不计入合格率" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource PanelBorder}" Padding="12,8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentItemName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentRuleCombinationText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentMeasured}"/>
                        <Border Grid.Column="2" Background="{StaticResource GreenPaleBrush}" Padding="16,4" CornerRadius="3" VerticalAlignment="Center"><TextBlock Text="{Binding CurrentResult}" FontSize="18" FontWeight="Bold" Foreground="{Binding CurrentResultBrush}"/></Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="导入测试序列后显示检测标签、判定逻辑和检测结果。" Visibility="{Binding EmptySequenceVisibility}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                    <ScrollViewer x:Name="CurrentItemDetailsScrollViewer" Visibility="{Binding LoadedSequenceVisibility}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Background="#EEF3F0" Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="检测标签" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock x:Name="DetectionLogicHeaderText" Grid.Column="1" Text="判定逻辑" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DetectionMeasuredHeaderText" Grid.Column="2" Text="本次实测" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DetectionResultHeaderText" Grid.Column="3" Text="Result" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid><Grid Grid.Column="1" Background="#EEF3F0" Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="检测标签" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="1" Text="判定逻辑" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="本次实测" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Result" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid></Grid>
                                        <ItemsControl x:Name="DetectionSummaryItemsControl" ItemsSource="{Binding DetectionSummary}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="30" Margin="0,0,12,0" Background="#FCFDFC" TextBlock.FontSize="13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="4*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="64" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Margin="10,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LogicText}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LogicText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding MeasuredText}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MeasuredDetailText}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Result}" Foreground="{Binding ResultBrush}"
                                                                   FontWeight="Bold" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#24352E" Padding="16,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="#EAF2EE" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RuntimeStatus}" Margin="0,0,18,0"/>
                    <ToggleButton x:Name="LogDetailsToggle" Grid.Column="1" Content="运行日志" FontSize="12" Padding="12,4" Margin="0,3" ToolTip="展开或收起运行日志，不影响日志文件记录"/>
                </Grid>
                <Border x:Name="RuntimeLogPanel" Grid.Row="1" Visibility="{Binding IsChecked, ElementName=LogDetailsToggle, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="#3E5149" BorderThickness="0,1,0,0" Padding="0,8" Height="140">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Logs}"><ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Foreground="#D9E5DF" FontSize="12" TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#AABCB4"/><Run Text="  ["/><Run Text="{Binding LevelText, Mode=OneWay}"/><Run Text="]  "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBlock Grid.Row="1" Text="{Binding LogFilePath}" ToolTip="{Binding LogFilePath}" Foreground="#AABCB4" FontSize="12" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
