<Window x:Class="VisualInspection.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VisualInspection.App.Controls"
        mc:Ignorable="d"
        Title="视觉检测测试部署系统"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="30" Background="{StaticResource GreenBrush}" CornerRadius="1" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="视觉检测" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="测试部署系统 · 操作员工作台" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="项目" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="测试序列" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding SequenceName}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="图像源" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SourceName}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SourceStateText}" FontSize="9" FontWeight="Bold" Margin="8,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInputSourceReady}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GreenDarkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="测试序列设置" Click="SequenceSettings_Click" IsEnabled="{Binding CanOpenSettings}"
                            Visibility="{Binding SettingsVisibility}" Margin="0,0,8,0"
                            Padding="10,5" FontSize="9" />
                    <Button Content="图源设置" Click="InputSourceSettings_Click" IsEnabled="{Binding CanOpenSettings}"
                            Visibility="{Binding SettingsVisibility}" Margin="0,0,14,0"
                            Padding="10,5" FontSize="9" />
                    <Border Background="{StaticResource GreenPaleBrush}" Padding="8,4" CornerRadius="2" Margin="0,0,12,0">
                        <TextBlock Text="{Binding RoleName}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTime}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Operator workspace: sequence + image + statistics -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Test sequence -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="114" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <TextBlock Text="测试序列" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GreenPaleBrush}" Padding="7,3" CornerRadius="9">
                                <TextBlock Text="{Binding ItemCountText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sequence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GreenPaleBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                                    Background="{Binding ResultBrush}">
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="10"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResultText}" FontSize="9" FontWeight="Bold" Margin="0,5,0,0"
                                                           Foreground="{Binding ResultBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.ColumnSpan="3" Content="开始测试" Command="{Binding StartCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                        <Button Grid.Row="1" Grid.Column="0" Content="停止" Command="{Binding StopCommand}"
                                Style="{StaticResource DangerButton}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="复位" Command="{Binding ResetCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Live image and current inspection -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="126" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}" Background="#E8EDEB" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D9E1DD" Offset="0" />
                                <GradientStop Color="#F0F3F2" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid Opacity="0.35">
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 28,0 28,28">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#CAD4CF" Thickness="1" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                        </Grid>

                        <Image Source="{Binding CurrentImage}" Stretch="Uniform" Margin="12" />

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                Background="#EAF5F0" BorderBrush="#BCDCCE" BorderThickness="1" Padding="10,7" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="当前图像源" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SourceName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                <TextBlock Text="{Binding InputSourceStatus}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Background="#CC23342D" Padding="9,6" CornerRadius="2">
                            <TextBlock Text="验收模式 · 640 × 360" Foreground="White" FontSize="10" />
                        </Border>
                        <TextBlock Text="已采集图像 · ROI / 检测框叠加" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,14" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前检测项" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CurrentItemName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding CurrentStandard}"
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentMeasured}"
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentExecutionDetails}"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource GreenPaleBrush}" BorderBrush="#B7DACC"
                                BorderThickness="1" CornerRadius="4" Margin="14,0,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="结果" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding CurrentResult}" FontSize="28" FontWeight="Bold" Foreground="{Binding CurrentResultBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Global statistics -->
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="96" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="72" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <TextBlock Text="全局统计" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="当前会话" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EDF8F3" CornerRadius="3" Padding="10">
                            <StackPanel>
                                <TextBlock Text="有效总数" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Statistics.TotalCount}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#EDF8F3" CornerRadius="3" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="通过" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Statistics.PassCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FFF1F1" CornerRadius="3" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="不通过" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Statistics.FailCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource FailBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#FFF6E9" CornerRadius="3" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="错误" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Statistics.ErrorCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="显示方式" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <RadioButton Content="数量" GroupName="StatisticsMode" IsChecked="{Binding Statistics.IsCountMode}" />
                            <RadioButton Content="比率" GroupName="StatisticsMode" IsChecked="{Binding Statistics.IsRateMode}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Margin="20">
                        <Grid Visibility="{Binding Statistics.IsCountMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="检测结果数量" FontSize="10" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock Text="通过" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Height="28" Margin="0,7,0,12" HorizontalAlignment="Left">
                                    <Border Width="256" Height="14" Background="#E2EAE6" CornerRadius="2" HorizontalAlignment="Left" />
                                    <Border Width="{Binding Statistics.PassBarWidth}" Height="14" Background="{StaticResource GreenBrush}"
                                            CornerRadius="2" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Statistics.PassCount}" FontSize="11" FontWeight="SemiBold" Margin="266,-1,0,0" />
                                </Grid>
                                <TextBlock Text="不通过" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid Height="28" Margin="0,7,0,8" HorizontalAlignment="Left">
                                    <Border Width="256" Height="14" Background="#E2EAE6" CornerRadius="2" HorizontalAlignment="Left" />
                                    <Border Width="{Binding Statistics.FailBarWidth}" Height="14" Background="{StaticResource FailBrush}"
                                            CornerRadius="2" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Statistics.FailCount}" FontSize="11" FontWeight="SemiBold" Margin="266,-1,0,0" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="2" Margin="0,14,0,0" Padding="12"
                                    Background="#F8FAF9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="通过 / 不通过分布" FontSize="10" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox MaxWidth="160" MaxHeight="160" Stretch="Uniform" StretchDirection="DownOnly">
                                            <controls:PassFailPieChart Width="160" Height="160"
                                                                       PassCount="{Binding Statistics.PassCount}"
                                                                       FailCount="{Binding Statistics.FailCount}"
                                                                       ToolTip="通过与不通过检测结果分布" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Rectangle Width="10" Height="10" Fill="{StaticResource GreenBrush}" Margin="0,2,7,0" />
                                                <TextBlock FontSize="10">
                                                    <Run Text="通过  " />
                                                    <Run Text="{Binding Statistics.PassCount, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="10" Height="10" Fill="{StaticResource FailBrush}" Margin="0,2,7,0" />
                                                <TextBlock FontSize="10">
                                                    <Run Text="不通过  " />
                                                    <Run Text="{Binding Statistics.FailCount, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="错误不计入饼图" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,16,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Visibility="{Binding Statistics.IsRateMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="通过 / 不通过比率" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <controls:DonutChart Width="230" Height="230" Margin="0,22,0,14"
                                                 PassRate="{Binding Statistics.PassRate}"
                                                 CenterText="{Binding Statistics.PassRateText}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Rectangle Width="9" Height="9" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="通过" FontSize="10" Margin="0,0,20,0" />
                                <Rectangle Width="9" Height="9" Fill="{StaticResource FailBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="不通过" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="有效检测" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Statistics.ValidCount}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="错误统计口径" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="不计入通过率" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status and compact log -->
        <Border Grid.Row="2" Background="#24352E" Padding="16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#4CC89B" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#EAF2EE" FontSize="10" />
                </StackPanel>
                <TextBlock Text="{Binding RuntimeStatus}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AABCB4" FontSize="10" />
                <Border Grid.Row="1" BorderBrush="#3E5149" BorderThickness="0,1,0,0" Padding="0,5,0,3" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="实时日志" Foreground="#8FA39A" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Top" />
                        <ItemsControl ItemsSource="{Binding Logs}" Margin="66,0,430,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#D9E5DF" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,0,0,2">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#8FA39A" />
                                        <Run Text="  [" /><Run Text="{Binding LevelText, Mode=OneWay}" /><Run Text="]  " />
                                        <Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="410">
                            <TextBlock Text="日志文件" Foreground="#8FA39A" FontSize="8" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LogFilePath}" Foreground="#70857B" FontSize="8"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
