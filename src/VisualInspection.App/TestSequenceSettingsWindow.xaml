<Window x:Class="VisualInspection.App.TestSequenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员 · 测试序列设置"
        Width="1240" Height="820" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="测试序列设置" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="模型与标签、目标绑定、普通规则、ROI、姿态步骤和运行参数"
                               FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource GreenPaleBrush}" CornerRadius="3" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="管理员配置" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="项目" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="项目名称" Margin="0,16,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="ProjectNameBox" Height="32" />
                                <TextBlock Text="工位" Margin="0,12,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="WorkstationBox" Height="32" />
                                <Border Background="#F5F8F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="12" Margin="0,18,0,0">
                                    <TextBlock Text="项目名称和工位会显示在操作员工位信息中。配置保存后，主工作台会立即重新加载。"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="测试序列" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="名称" Margin="0,16,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="SequenceNameBox" Height="32" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="版本" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="SequenceVersionBox" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="默认延时（毫秒）" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="DefaultDelayBox" Height="32" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="绑定图源" Margin="0,12,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox x:Name="InputSourceCombo" Height="32" DisplayMemberPath="Name" />
                                <TextBlock Text="运行时图源策略" Margin="0,12,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <ComboBox x:Name="SourcePolicyCombo" Height="32" />
                                <CheckBox x:Name="PublishedCheck" Content="标记为已发布版本" Margin="0,16,0,0" />
                                <TextBlock Text="发布版本必须通过全部配置校验，并为所用模型记录 SHA-256。"
                                           Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="模型与标签">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="模型列表" Style="{StaticResource SectionTitle}" Margin="4" />
                            <ListBox x:Name="ModelsList" Grid.Row="1" Margin="0,10" DisplayMemberPath="Name"
                                     SelectionChanged="ModelsList_SelectionChanged" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="新增模型" Click="AddModel_Click" Margin="0,0,8,0" />
                                <Button Content="删除" Click="DeleteModel_Click" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="模型信息" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="模型名称" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="ModelNameBox" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="版本" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="ModelVersionBox" Height="32" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="文件格式" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="ModelFormatCombo" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="任务类型" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="ModelTaskCombo" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="标签来源" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="LabelSourceCombo" Height="32" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="模型文件" Margin="0,12,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ModelPathBox" Height="32" />
                                    <Button Grid.Column="2" Content="选择文件..." Click="BrowseModel_Click" Height="32" />
                                    <Button Grid.Column="4" Content="读取标签" Click="ImportModelLabels_Click" Height="32" />
                                </Grid>
                                <TextBlock Text="标签（每行使用“编号=名称”）" Margin="0,14,0,5" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="LabelsBox" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" TextWrapping="NoWrap" />
                                <Border Background="#FFF9EA" BorderBrush="#E7D49D" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,12,0,0">
                                    <TextBlock Text="ONNX 可读取 names、labels、class_names、classes 元数据；当前真实推理支持静态 Float[1,3,H,W] 输入与端到端 Float[1,N,6] 输出的目标检测模型。PT 与其他 ONNX 输出协议仍需对应适配器。"
                                               TextWrapping="Wrap" Foreground="#715319" FontSize="10" />
                                </Border>
                                <Button Content="应用模型修改" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Click="ApplyModel_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="目标与绑定">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="检测目标" Style="{StaticResource SectionTitle}" Margin="4" />
                            <ListBox x:Name="TargetsList" Grid.Row="1" Margin="0,10" DisplayMemberPath="Name"
                                     SelectionChanged="TargetsList_SelectionChanged" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="新增目标" Click="AddTarget_Click" Margin="0,0,8,0" />
                                <Button Content="删除" Click="DeleteTarget_Click" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="目标与模型绑定" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="先选择目标，再为该目标指定模型及输出标签。规则只引用明确的绑定，不使用隐式模型选择。"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                            <TextBlock Text="目标名称" Margin="0,0,0,5" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="TargetNameBox" Height="32" />
                            <TextBlock Text="绑定模型" Margin="0,14,0,5" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="BindingModelCombo" Height="32" DisplayMemberPath="Name"
                                      SelectionChanged="BindingModelCombo_SelectionChanged" />
                            <TextBlock Text="输出标签" Margin="0,14,0,5" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="BindingLabelCombo" Height="32" />
                            <Button Content="应用目标与绑定" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Margin="0,18,0,0" Click="ApplyTarget_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="规则与 ROI">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10">
                        <Grid>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="170" />
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="*" />
                             </Grid.RowDefinitions>
                             <TextBlock Text="普通检测项" Style="{StaticResource SectionTitle}" Margin="4" />
                             <ListBox x:Name="NormalItemsList" Grid.Row="1" Margin="0,8" DisplayMemberPath="Name"
                                      SelectionChanged="NormalItemsList_SelectionChanged" />
                             <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                 <Button x:Name="AddNormalItemButton" Content="新增检测项" Click="AddNormalItem_Click"
                                         Margin="0,0,8,0" Padding="10,5" FontSize="10" />
                                 <Button x:Name="DeleteNormalItemButton" Content="删除检测项" Click="DeleteNormalItem_Click"
                                         Style="{StaticResource DangerButton}" Padding="10,5" FontSize="10" />
                             </StackPanel>
                             <TextBlock Grid.Row="3" Text="当前项规则" FontWeight="SemiBold" Margin="4,6" />
                             <ListBox x:Name="RulesList" Grid.Row="4" DisplayMemberPath="Display"
                                      SelectionChanged="RulesList_SelectionChanged" />
                         </Grid>
                     </Border>
                     <Border x:Name="NormalRuleEditor" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="检测项与判定规则" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="检测项名称" Margin="0,12,0,4" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox x:Name="NormalItemNameBox" Height="30" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="单项延时（空白=默认）" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBox x:Name="NormalItemDelayBox" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="多规则逻辑" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="RuleLogicalCombo" Height="30" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <CheckBox x:Name="NormalItemEnabledCheck" Content="启用" Margin="0,0,16,0" />
                                    <CheckBox x:Name="NormalItemRequiredCheck" Content="必测项" />
                                </StackPanel>
                                <Separator Margin="0,8" />
                                <TextBlock Text="目标" Foreground="{StaticResource MutedTextBrush}" Margin="0,4" />
                                <ComboBox x:Name="RuleTargetCombo" Height="30" DisplayMemberPath="Name"
                                          SelectionChanged="RuleTargetCombo_SelectionChanged" />
                                <TextBlock Text="模型绑定" Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,4" />
                                <ComboBox x:Name="RuleBindingCombo" Height="30" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数量指标" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="RuleMetricCombo" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="比较方式" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="RuleOperatorCombo" Height="30" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="阈值" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="RuleThresholdBox" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="上限" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="RuleUpperBox" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="预期数量" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="RuleExpectedBox" Height="30" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="置信度" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="RuleConfidenceBox" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="条件成立时" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="RuleOutcomeCombo" Height="30" />
                                    </StackPanel>
                                 </Grid>
                                 <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                     <Button x:Name="ApplyRuleButton" Content="应用规则" Style="{StaticResource PrimaryButton}" Click="ApplyRule_Click" Margin="0,0,8,0" />
                                     <Button x:Name="AddRuleButton" Content="新增规则" Click="AddRule_Click" Margin="0,0,8,0" />
                                     <Button x:Name="DeleteRuleButton" Content="删除" Style="{StaticResource DangerButton}" Click="DeleteRule_Click" />
                                 </StackPanel>
                             </StackPanel>
                         </ScrollViewer>
                     </Border>
                     <Border x:Name="RoiEditor" Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="检测区域" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="区域范围" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,4" />
                                <ComboBox x:Name="RuleScopeCombo" Height="30" SelectionChanged="RuleScopeCombo_SelectionChanged" />
                                <TextBlock Text="ROI 名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
                                <TextBox x:Name="RoiNameBox" Height="30" />
                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="X1" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiX1Box" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Y1" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiY1Box" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="X2" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiX2Box" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                    <StackPanel><TextBlock Text="Y2" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiY2Box" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="参考宽度" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiReferenceWidthBox" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                    <StackPanel><TextBlock Text="参考高度" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="RoiReferenceHeightBox" Height="28" TextChanged="RoiCoordinate_TextChanged" /></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="在图像上按住鼠标拖动，可直接回填 ROI 坐标。" Margin="0,12,0,6"
                                           Foreground="{StaticResource GreenDarkBrush}" FontSize="10" />
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#202420">
                                    <Canvas x:Name="RuleRoiCanvas" Width="480" Height="270" ClipToBounds="True"
                                            MouseLeftButtonDown="RuleRoiCanvas_MouseLeftButtonDown"
                                            MouseMove="RuleRoiCanvas_MouseMove"
                                            MouseLeftButtonUp="RuleRoiCanvas_MouseLeftButtonUp">
                                        <Image x:Name="RulePreviewImage" Width="480" Height="270" Stretch="Fill" IsHitTestVisible="False" />
                                        <Rectangle x:Name="RuleRoiRectangle" Stroke="{StaticResource GreenBrush}" StrokeThickness="2"
                                                   Fill="#223DCD58" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <TextBlock x:Name="RulePreviewPlaceholder" Text="暂无预览图像" Foreground="#DDE4DE"
                                                   Canvas.Left="196" Canvas.Top="126" IsHitTestVisible="False" />
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="姿态序列">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="姿态测试项" Style="{StaticResource SectionTitle}" />
                            <ListBox x:Name="PoseItemsList" Grid.Row="1" DisplayMemberPath="Name" Margin="0,8"
                                     SelectionChanged="PoseItemsList_SelectionChanged" />
                            <TextBlock Grid.Row="2" Text="动作步骤" FontWeight="SemiBold" Margin="0,8,0,5" />
                            <ListBox x:Name="PoseStepsList" Grid.Row="3" DisplayMemberPath="Display"
                                     SelectionChanged="PoseStepsList_SelectionChanged" />
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="新增步骤" Click="AddPoseStep_Click" Margin="0,0,8,0" />
                                <Button Content="上移" Click="MovePoseStepUp_Click" Margin="0,0,8,0" />
                                <Button Content="下移" Click="MovePoseStepDown_Click" Margin="0,0,8,0" />
                                <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeletePoseStep_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="动作画布" Style="{StaticResource SectionTitle}" />
                                <Border Background="#F5F8F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="14" Margin="0,10,0,16" MinHeight="86">
                                    <WrapPanel x:Name="PoseCanvasPanel" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="姿态项名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="PoseItemNameBox" Height="30" />
                                <TextBlock Text="单项延时（空白=默认）" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
                                <TextBox x:Name="PoseItemDelayBox" Height="30" />
                                <Separator Margin="0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="步骤名称" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="PoseStepNameBox" Height="30" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="动作条件" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="PoseActionBox" Height="30" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="模型绑定" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
                                <ComboBox x:Name="PoseBindingCombo" Height="30" />
                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="置信度" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="PoseConfidenceBox" Height="30" /></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="保持时间（毫秒）" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="PoseHoldBox" Height="30" /></StackPanel>
                                    <StackPanel><TextBlock Text="最大等待（毫秒）" Foreground="{StaticResource MutedTextBrush}" /><TextBox x:Name="PoseWaitBox" Height="30" /></StackPanel>
                                </UniformGrid>
                                <CheckBox x:Name="PoseRequiredCheck" Content="必需步骤" Margin="0,12,0,0" />
                                <Button Content="应用姿态步骤" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Click="ApplyPoseStep_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="输入源">
                <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="20" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="测试序列绑定图源" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="InputSourceSummaryText" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="此处决定测试序列使用哪个图源；文件夹路径、排序、坏图策略、相机设备等详细参数请从操作员工作台顶部的“图源设置”进入。"
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Border Background="#FFF9EA" BorderBrush="#E7D49D" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,16,0,0">
                            <TextBlock Text="DirectShow 与厂商相机当前仍为适配器门禁状态；保存相机配置不会伪报设备已连接。"
                                       TextWrapping="Wrap" Foreground="#715319" />
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="用户与权限">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="管理员" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="管理员登录后可进入测试序列设置和图源设置，并执行操作员工作台。"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="当前为单机本地账户，密码使用 PBKDF2-SHA256 哈希保存；账户增删、改密和生产身份源仍待开发。"
                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="操作员" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="操作员登录后直接进入操作员工作台，不显示测试序列设置和图源设置入口。"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Text="当前已完成管理员/操作员会话隔离；已发布序列强制分配和生产密码策略仍属于后续权限增量。"
                                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationText" Text="尚未保存。各编辑页的修改会在保存时统一校验。"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" Width="90" IsCancel="True" Margin="0,0,10,0" />
                    <Button Content="校验并保存" Width="132" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
