<Window x:Class="VisualInspection.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 · 视觉检测测试部署系统"
        Width="920" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#20342A">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="48" Height="48" Background="{StaticResource GreenBrush}" CornerRadius="4" HorizontalAlignment="Left">
                        <TextBlock Text="VI" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="视觉检测" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="0,22,0,0" />
                    <TextBlock Text="测试部署系统" FontSize="13" Foreground="#B8C7BF" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="角色权限" Foreground="#8FA39A" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="管理员可进入全部设置；操作员登录后直接进入测试执行与统计界面。"
                               Foreground="#E2EAE5" TextWrapping="Wrap" FontSize="13" LineHeight="22" Margin="0,10,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Visual Inspection Test Deployment" Foreground="#70857B" FontSize="9" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="56,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="登录工作站" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="请输入本机账户，系统将按角色加载可用功能。"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,22" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="用户名" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox" Height="38" FontSize="13" VerticalContentAlignment="Center" Text="admin" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="密码" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInput" Height="38" FontSize="13" VerticalContentAlignment="Center"
                             KeyDown="PasswordInput_KeyDown" />
            </StackPanel>
            <TextBlock x:Name="LoginStatusText" Grid.Row="4" Text=" " Foreground="{StaticResource FailBrush}" Margin="0,10,0,0" />

            <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                <Border Background="#FFF9EA" BorderBrush="#E7D49D" BorderThickness="1" CornerRadius="3" Padding="12">
                    <StackPanel>
                        <TextBlock Text="本地验收账户" FontWeight="SemiBold" Foreground="#715319" />
                        <TextBlock Text="管理员：admin / Admin@123" Margin="0,6,0,0" FontFamily="Consolas" />
                        <TextBlock Text="操作员：operator / Operator@123" Margin="0,3,0,0" FontFamily="Consolas" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="填入管理员" Click="FillAdmin_Click" Margin="0,0,8,0" Height="30" MinHeight="30" Padding="10,3" />
                            <Button Content="填入操作员" Click="FillOperator_Click" Height="30" MinHeight="30" Padding="10,3" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="账户文件仅保存 PBKDF2-SHA256 密码哈希；以上固定密码只用于本地验收。"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="退出" Width="88" IsCancel="True" Margin="0,0,10,0" />
                <Button Content="登录" Width="110" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
