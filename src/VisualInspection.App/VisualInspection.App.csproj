<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="VisualInspection.App.Tests" />
    <ProjectReference Include="..\VisualInspection.Core\VisualInspection.Core.csproj" />
    <ProjectReference Include="..\VisualInspection.Infrastructure\VisualInspection.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.6.0</Version>
    <InformationalVersion>0.6.0-onnx-yolo-e2e-zh-CN</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FrontendDemo)' == 'true'">
    <AssemblyName>VisualInspection.FrontendDemo</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="'$(FrontendDemo)' == 'true' and Exists('$(FrontendDemoFanModelPath)') and Exists('$(FrontendDemoFanImagePath)')">
    <EmbeddedResource Include="$(FrontendDemoFanModelPath)" LogicalName="VisualInspection.FrontendDemo.Assets.fan.onnx" />
    <EmbeddedResource Include="$(FrontendDemoFanImagePath)" LogicalName="VisualInspection.FrontendDemo.Assets.IMG_1533.JPG" />
  </ItemGroup>

</Project>
