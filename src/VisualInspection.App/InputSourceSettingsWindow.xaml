<Window x:Class="VisualInspection.App.InputSourceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理员 · 图像源设置"
        Width="940" Height="700" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="图像源设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="管理员配置 · 保存前自动校验修改内容" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GreenPaleBrush}"
                        BorderBrush="#B7DACC" BorderThickness="1" CornerRadius="3" Padding="10,5">
                    <TextBlock Text="仅限管理员" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,10,14,0" Background="#FFF7E8" BorderBrush="#E8CC8D"
                BorderThickness="1" CornerRadius="3" Padding="12,7">
            <TextBlock Text="验收版本：文件夹图源可用；DirectShow 与厂商相机仅提供配置入口，安装适配器前禁止运行。"
                       FontSize="10" Foreground="#715319" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="SourceTabs" Grid.Row="2" Margin="14,12,14,0">
            <TabItem Header="文件夹图源">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="图像文件夹" FontWeight="SemiBold" FontSize="11" />
                    <Grid Grid.Row="1" Margin="0,7,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" />
                        <Button Grid.Column="2" Content="浏览..." Click="BrowseFolder_Click" />
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="使用内置通过数据" HorizontalAlignment="Left"
                                Padding="12,6" Click="UseBuiltIn_Click" />
                        <Button Content="使用内置不通过数据" HorizontalAlignment="Left" Margin="10,0,0,0"
                                Padding="12,6" Click="UseBuiltInFail_Click" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="排序方式" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="SortOrderCombo" Height="30" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="无效文件处理" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="InvalidBehaviorCombo" Height="30" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="IncludeSubfoldersCheck" Content="包含子文件夹" Margin="0,0,20,0" />
                        <CheckBox x:Name="LoopPlaybackCheck" Grid.Column="1" Content="循环播放" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="姿态帧间隔" VerticalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                            <TextBox x:Name="PoseIntervalBox" Width="64" Height="28" VerticalContentAlignment="Center" TextAlignment="Right" />
                            <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="5" Margin="0,20,0,0" Background="#F5F8F7" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Content="校验图源" Width="132" HorizontalAlignment="Left" Click="ValidateFolder_Click" />
                            <TextBlock x:Name="ValidationText" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       Text="尚未校验。" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Grid.RowSpan="6" Background="#E8EDEB" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Background="#CC24352E"
                                    CornerRadius="2" Padding="8,5">
                                <TextBlock Text="图源预览" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="PreviewPlaceholder" Text="校验文件夹后加载第一张可读图像。"
                                       Width="230" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="相机图源">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="相机适配器类型" VerticalAlignment="Center" />
                    <ComboBox x:Name="CameraTypeCombo" Grid.Column="1" Height="30" />
                    <TextBlock Grid.Row="1" Text="适配器标识" VerticalAlignment="Center" Margin="0,14,0,0" />
                    <TextBox x:Name="AdapterIdBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,14,0,0" Text="directshow" />
                    <TextBlock Grid.Row="2" Text="设备标识" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBox x:Name="DeviceIdBox" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,10,0,0" Text="0" />
                    <TextBlock Grid.Row="3" Text="分辨率 / 帧率" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="CameraWidthBox" Width="70" Height="30" Text="1920" />
                        <TextBlock Text=" × " VerticalAlignment="Center" />
                        <TextBox x:Name="CameraHeightBox" Width="70" Height="30" Text="1080" />
                        <TextBlock Text=" @ " VerticalAlignment="Center" />
                        <TextBox x:Name="FrameRateBox" Width="70" Height="30" Text="30" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="取帧超时" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="GrabTimeoutBox" Width="90" Height="30" Text="1000" />
                        <TextBlock Text=" 毫秒" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="2" Grid.RowSpan="5" Margin="24,0,0,0" Background="#FFF7E8" BorderBrush="#E8CC8D"
                            BorderThickness="1" CornerRadius="3" Padding="18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="适配器尚未安装" FontWeight="Bold" Foreground="#715319" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#715319"
                                       Text="配置可以保存用于后续集成，但校验和开始测试仍会被阻止。DirectShow 与各厂商 SDK 将统一封装在 IImageSource 接口之后。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,10">
                <TextBlock Text="保存后将更新当前项目并刷新操作员工作台。"
                           VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="90" Margin="0,0,10,0" IsCancel="True" />
                    <Button Content="保存图源" Width="126" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
